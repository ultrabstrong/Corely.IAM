@page "/profile"
@attribute [Authorize]
@using Corely.IAM.FederatedIdentities.Models
@inherits OperationComponentBase
@inject NavigationManager NavigationManager

<PageTitle>Profile</PageTitle>

<h1 class="h3 mb-3">Profile</h1>

<div class="props-grid mb-3">
    <span class="prop-label">Username</span>
    <span class="prop-value">@_username</span>
    <span class="prop-label">Email</span>
    <span class="prop-value">@_email</span>
</div>

@if (_authMethodsLoaded)
{
    <TotpSection />
    <PasswordSection HasBasicAuth="_hasBasicAuth" HasLinkedIdentity="_linkedIdentities.Count > 0" OnStatusChanged="() => InOperationAsync(LoadAuthMethodsAsync)" />
    <LinkedIdentitiesSection LinkedIdentities="_linkedIdentities" OnStatusChanged="() => InOperationAsync(LoadAuthMethodsAsync)" />
}
else
{
    <LoadingSpinner />
}

<div class="section-divider mb-4 mt-4">
    <div class="section-divider-label">Delete</div>
    <Alert Message="@_deleteError" Type="AlertType.Danger" OnDismissed="() => _deleteError = null" />
    <button class="btn btn-outline-danger btn-sm" @onclick="() => _deleteModal.Show()">Delete my account</button>
</div>

<ConfirmModal @ref="_deleteModal"
              Title="Delete account"
              Message="Permanently delete your account? Notes you wrote stay with the team. This cannot be undone."
              ConfirmText="Delete"
              OnConfirm="DeleteAsync" />

@code {

    private string? _username;
    private string? _email;
    private bool _authMethodsLoaded;
    private bool _hasBasicAuth;
    private IReadOnlyList<LinkedIdentity> _linkedIdentities = [];
    private string? _deleteError;
    private ConfirmModal _deleteModal = null!;

    protected override async Task OnInitializedAsync()
    {
        await InOperationAsync(async services =>
        {
            var user = (await services.GetRequiredService<IBlazorUserContextAccessor>().GetUserContextAsync())!.User!;
            _username = user.Username;
            _email = user.Email;
            await LoadAuthMethodsAsync(services);
        });
    }

    private async Task LoadAuthMethodsAsync(IServiceProvider services)
    {
        var methods = await services.GetRequiredService<IFederatedIdentityService>().GetAuthMethodsAsync();
        _hasBasicAuth = methods.HasBasicAuth;
        _linkedIdentities = methods.LinkedIdentities;
        _authMethodsLoaded = methods.ResultCode == AuthMethodsResultCode.Success;
    }

    private async Task DeleteAsync()
    {
        var result = await InOperationAsync(services =>
            services.GetRequiredService<IDeregistrationService>().DeregisterUserAsync()
        );
        if (result is null)
            return;
        if (result.ResultCode != DeregisterUserResultCode.Success)
        {
            _deleteError = result.Message;
            return;
        }
        NavigationManager.NavigateTo(AppRoutes.SignOut, forceLoad: true);
    }
}
