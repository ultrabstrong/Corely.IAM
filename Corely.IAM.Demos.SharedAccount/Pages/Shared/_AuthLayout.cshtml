@{
    var title = ViewData["Title"]?.ToString() ?? "Team Notes";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Team Notes</title>
    <link rel="stylesheet" href="/_content/Corely.IAM.Demos.Bootstrap/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/_content/Corely.IAM.Demos.Bootstrap/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/_content/Corely.IAM.Web/css/iam-web.css" />
</head>
<body class="bg-light">
    <header class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="bi bi-people me-2"></i>Team Notes</a>
        </div>
    </header>

    <main class="container d-flex justify-content-center">
        <div class="col-md-5 auth-container">
            @RenderBody()
        </div>
    </main>

    <script src="/_content/Corely.IAM.Demos.Bootstrap/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/_content/Corely.IAM.Web/js/form-busy.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
