@inherits LayoutComponentBase
@inject IBlazorUserContextAccessor UserContextAccessor

<nav class="navbar navbar-expand navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="bi bi-journal-text me-2"></i>My Notes</a>
        @if (_username != null)
        {
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person me-1"></i>@_username
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/profile"><i class="bi bi-person-gear me-2"></i>Profile</a></li>
                        <li><button type="button" class="dropdown-item theme-toggle-static" data-theme-toggle aria-label="Use dark theme"><i class="bi bi-moon-stars me-2" aria-hidden="true"></i><i class="bi bi-sun me-2" aria-hidden="true"></i>Switch theme</button></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="@AppRoutes.SignOut" data-enhance-nav="false"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                    </ul>
                </li>
            </ul>
        }
        else
        {
            <div class="ms-auto">
                <ThemeToggle />
            </div>
        }
    </div>
</nav>

<main class="container py-4">
    @Body
</main>

@code {
    private string? _username;

    protected override async Task OnInitializedAsync() =>
        _username = (await UserContextAccessor.GetUserContextAsync())?.User?.Username;
}
