@using Microsoft.AspNetCore.Routing
@inherits EntityPageBase
@inject IIamWebLinks Links
@inject IAccountDisplayState AccountDisplayState
@inject IJSRuntime JSRuntime

<div class="management-header">
    <h1><i class="bi bi-building me-2"></i>@_accountName <span class="resource-label">Account</span></h1>
    <a href="@Links.Dashboard()" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>

<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (_loading && _accountName == null)
{
    <LoadingSpinner />
}
else
{
    <div class="detail-section">

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Details
                @if (!_isEditing)
                {
                    <div class="d-flex gap-2">
                        <PermissionView Action="AuthAction.Update" Resource="@Account.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                            <button class="btn btn-outline-primary btn-sm" @onclick="StartEdit">Edit</button>
                        </PermissionView>
                        <PermissionView Action="AuthAction.Delete" Resource="@Account.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                            <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDelete" disabled="@_loading">Delete</button>
                        </PermissionView>
                    </div>
                }
                else if (_isEditing)
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_loading">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                    </div>
                }
            </div>
            @if (_isEditing)
            {
                <div class="props-grid mb-3">
                    <span class="prop-label">Account Name</span>
                    <div class="prop-value"><input type="text" class="form-control form-control-sm" @bind="_accountName" /></div>
                </div>
            }
            else
            {
                <div class="props-grid">
                    <span class="prop-label cell-hide">Account Name</span>
                    <span class="prop-value cell-title">@_accountName</span>
                </div>
            }
        </div>

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Invitations
                <PermissionView Action="AuthAction.Update" Resource="@Account.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                    <button class="btn btn-primary btn-sm" @onclick="ShowCreateInvitation" disabled="@_loading">Create Invitation</button>
                </PermissionView>
            </div>
            <table class="table table-striped table-hover table-cards mb-0">
                <thead class="list-head">
                    <tr>
                        <th class="@GetInvSortClass(nameof(Invitation.Email))" @onclick="() => CycleInvSortAsync(nameof(Invitation.Email))">
                            <span>Email <i class="bi @(GetInvSortIcon(nameof(Invitation.Email))) sort-icon"></i></span>
                            <div class="th-search" @onclick:stopPropagation="true">
                                <input type="text" class="form-control"
                                       placeholder="Search..."
                                       @bind="_invSearchEmail"
                                       @bind:event="oninput"
                                       @bind:after="OnInvSearchChangedAsync" />
                            </div>
                        </th>
                        <th class="@GetInvSortClass(nameof(Invitation.Description))" @onclick="() => CycleInvSortAsync(nameof(Invitation.Description))">
                            <span>Description <i class="bi @(GetInvSortIcon(nameof(Invitation.Description))) sort-icon"></i></span>
                            <div class="th-search" @onclick:stopPropagation="true">
                                <input type="text" class="form-control"
                                       placeholder="Search..."
                                       @bind="_invSearchDescription"
                                       @bind:event="oninput"
                                       @bind:after="OnInvSearchChangedAsync" />
                            </div>
                        </th>
                        <th>
                            <span>Status</span>
                            <div class="th-search" @onclick:stopPropagation="true">
                                <select class="form-select form-select-sm" @bind="_invStatusFilter" @bind:after="OnInvStatusChangedAsync">
                                    <option value="">All</option>
                                    @foreach (var status in Enum.GetValues<InvitationStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </div>
                        </th>
                        <th class="@GetInvSortClass(nameof(Invitation.CreatedUtc))" @onclick="() => CycleInvSortAsync(nameof(Invitation.CreatedUtc))">
                            <span>Created <i class="bi @(GetInvSortIcon(nameof(Invitation.CreatedUtc))) sort-icon"></i></span>
                        </th>
                        <th class="@GetInvSortClass(nameof(Invitation.ExpiresUtc))" @onclick="() => CycleInvSortAsync(nameof(Invitation.ExpiresUtc))">
                            <span>Expires <i class="bi @(GetInvSortIcon(nameof(Invitation.ExpiresUtc))) sort-icon"></i></span>
                        </th>
                        <th class="table-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_invitations.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted text-center">No invitations</td></tr>
                    }
                    @foreach (var inv in _invitations)
                    {
                        <tr>
                            <td class="cell-title">@inv.Email</td>
                            <td class="@(string.IsNullOrWhiteSpace(inv.Description) ? "cell-hide" : "text-muted")">@(inv.Description ?? "")</td>
                            <td class="cell-badge">
                                @if (inv.IsAccepted)
                                {
                                    <span class="badge bg-info">Accepted</span>
                                }
                                else if (inv.IsRevoked)
                                {
                                    <span class="badge bg-danger">Revoked</span>
                                }
                                else if (inv.IsExpired(DateTime.UtcNow))
                                {
                                    <span class="badge bg-secondary">Expired</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Pending</span>
                                }
                            </td>
                            <td class="cell-hide"><small><LocalTime Value="inv.CreatedUtc" /></small></td>
                            <td class="cell-hide"><small><LocalTime Value="inv.ExpiresUtc" /></small></td>
                            <td class="cell-only text-muted"><small>Expires <LocalTime Value="inv.ExpiresUtc" /></small></td>
                            <td class="table-actions cell-actions">
                                <div class="row-actions">
                                    @if (inv.IsPending(DateTime.UtcNow))
                                    {
                                        <PermissionView Action="AuthAction.Update" Resource="@Account.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRevokeInvitation(inv.Id, inv.Email)" title="Revoke"><i class="bi bi-x-circle"></i></button>
                                        </PermissionView>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Skip="_invitationsSkip" Take="@InvitationPageSize" TotalCount="@_invitationsTotalCount"
                        OnPageChanged="OnInvitationPageChangedAsync" />
        </div>

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Users
            </div>
            <table class="table table-striped table-hover table-cards mb-0">
                <thead class="list-head"><tr><th>Name</th><th class="table-actions">Actions</th></tr></thead>
                <tbody>
                    @if (_users.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted text-center">No users</td></tr>
                    }
                    @foreach (var user in PagedUsers)
                    {
                        <tr>
                            <td class="cell-title">
                                @user.Name
                                <br /><CopyableId Value="user.Id" />
                            </td>
                            <td class="table-actions cell-actions">
                                <div class="row-actions">
                                    <a href="@Links.User(CurrentAccountId, user.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                    <PermissionView Action="AuthAction.Update" Resource="@Account.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRemoveUser(user.Id, user.Name)" title="Remove"><i class="bi bi-trash"></i></button>
                                    </PermissionView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Skip="_usersSkip" Take="@RelationPageSize" TotalCount="@UsersTotalCount"
                        OnPageChanged="newSkip => { _usersSkip = newSkip; StateHasChanged(); }" />
        </div>

        <PermissionView Action="AuthAction.Read" Resource="@Account.RESOURCE_TYPE" ResourceIds="new[] { Id }">
            <PermissionView Action="AuthAction.Update" Resource="@Account.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                <Authorized>
                    <EncryptionSigningPanel SymProvider="_symProvider" AsymProvider="_asymProvider" SigProvider="_sigProvider"
                                            DescriptionText="@KEYS_DESCRIPTION" ShowKeyVersions="true" PublicKeysAddress="@PublicKeysAddress" RotateKeyAsync="RotateKeyAsync" RotateCompromisedKeyAsync="RotateCompromisedKeyAsync" MarkKeyCompromisedAsync="MarkKeyCompromisedAsync"
                                            RevealKeyAsync="RevealKeyHandler" ProofProviders="_proofProviders" CanProveIdentity="_canProveIdentity" />
                </Authorized>
                <NotAuthorized>
                    <EncryptionSigningPanel SymProvider="_symProvider" AsymProvider="_asymProvider" SigProvider="_sigProvider"
                                            DescriptionText="@KEYS_DESCRIPTION" ShowKeyVersions="true" PublicKeysAddress="@PublicKeysAddress" RevealKeyAsync="RevealKeyHandler"
                                            ProofProviders="_proofProviders" CanProveIdentity="_canProveIdentity" />
                </NotAuthorized>
            </PermissionView>
        </PermissionView>

        <PermissionView Action="AuthAction.Read" Resource="@AccountAuditSettings.RESOURCE_TYPE">
            <AuditSettingsSection AccountId="Id" />
        </PermissionView>

        <EffectivePermissionsPanel AccountId="CurrentAccountId" Permissions="_effectivePermissions" UseCard="false" />

    </div>
}

<ConfirmModal @ref="_removeUserModal" Title="Remove User" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveUserAsync" />
<ConfirmModal @ref="_deleteModal" Title="Delete Account" Message="@($"Permanently delete account '{_accountName}'? This cannot be undone.")" ConfirmText="Delete" OnConfirm="DeleteAsync" />
<ConfirmModal @ref="_revokeInvitationModal" Title="Revoke Invitation" Message="@_confirmMessage" ConfirmText="Revoke" OnConfirm="RevokeInvitationAsync" />

<FormModal @ref="_createInvitationModal" Title="Create Invitation" ConfirmText="Create" OnConfirm="CreateInvitationAsync">
    <div class="mb-3">
        <label class="form-label">Email <span class="text-danger">*</span></label>
        <input type="email" class="form-control form-control-sm" @bind="_inviteEmail" placeholder="recipient@example.com" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <input type="text" class="form-control form-control-sm" @bind="_inviteDescription" placeholder="Optional note" maxlength="200" />
    </div>
    <div class="mb-3">
        <label class="form-label">Expires In</label>
        <select class="form-select form-select-sm" @bind="_inviteExpirySeconds">
            <option value="3600">1 hour</option>
            <option value="86400">1 day</option>
            <option value="604800">7 days</option>
            <option value="2592000">30 days</option>
        </select>
    </div>
</FormModal>

<ShownOnceModal @ref="_invitationCreatedModal" />

@code {
    private Guid Id => CurrentAccountId;

    private string? _accountName;
    private string? _originalAccountName;
    private bool _isEditing;
    private List<ChildRef> _users = [];
    private List<EffectivePermission>? _effectivePermissions;
    private ConfirmModal _removeUserModal = null!;
    private ConfirmModal _deleteModal = null!;
    private ConfirmModal _revokeInvitationModal = null!;
    private FormModal _createInvitationModal = null!;

    private List<Invitation> _invitations = [];
    private int _invitationsTotalCount;
    private string _invSearchEmail = string.Empty;
    private string _invSearchDescription = string.Empty;
    private InvitationStatus? _invStatusFilter;
    private string? _invSortColumn;
    private SortDirection? _invSortDirection;
    private string? _inviteEmail;
    private string? _inviteDescription;
    private int _inviteExpirySeconds = CreateInvitationRequest.DEFAULT_EXPIRY_SECONDS;
    private ShownOnceModal _invitationCreatedModal = null!;
    private CancellationTokenSource? _invSearchCts;

    private int _usersSkip;
    private int _invitationsSkip;
    private const int RelationPageSize = 10;
    private const int InvitationPageSize = 10;
    private List<ChildRef> PagedUsers => _users.Skip(_usersSkip).Take(RelationPageSize).ToList();
    private int UsersTotalCount => _users.Count;

    private IIamSymmetricEncryptionProvider? _symProvider;
    private IIamAsymmetricEncryptionProvider? _asymProvider;
    private IIamAsymmetricSignatureProvider? _sigProvider;
    private bool _canRevealKeys;
    private bool _canProveIdentity = true;
    private IReadOnlyList<IdentityProviderOption>? _proofProviders;

    private Func<KeyType, string?, string?, Task<RevealAccountKeyResult>>? RevealKeyHandler =>
        _canRevealKeys ? RevealKeyAsync : null;

    protected override async Task LoadCoreAsync(IServiceProvider services)
    {
        PublicKeysAddress = services.GetService<LinkGenerator>()?.AccountJwksPath(CurrentAccountId) is { } path
            ? NavigationManager.ToAbsoluteUri(path.TrimStart('/')).ToString()
            : null;
        var result = await services.GetRequiredService<IRetrievalService>().GetAccountAsync(Id, hydrate: true);
        if (result.ResultCode == RetrieveResultCode.Success && result.Item != null)
        {
            _accountName = result.Item.AccountName;
            _users = result.Item.Users ?? [];
            _effectivePermissions = result.EffectivePermissions;
            _canRevealKeys = UserContext?.User != null
                && await services.GetRequiredService<IAuthorizationProvider>().IsAuthorizedAsync(AuthAction.Execute, Account.SECRET_KEYS_RESOURCE_TYPE, Id);
            await LoadRevealProofAsync(services);
        }
        else
        {
            NavigationManager.NavigateTo(Links.Dashboard());
            return;
        }

        await LoadInvitationsAsync(services);
        await LoadKeyProvidersAsync(services);
    }

    private async Task LoadInvitationsAsync(IServiceProvider services)
    {
        var filterBuilder = Filter.For<Invitation>();
        var hasFilter = false;
        if (!string.IsNullOrWhiteSpace(_invSearchEmail))
        {
            filterBuilder.Where(i => i.Email, StringFilter.Contains(_invSearchEmail.Trim()));
            hasFilter = true;
        }
        if (!string.IsNullOrWhiteSpace(_invSearchDescription))
        {
            filterBuilder.Where(i => i.Description!, StringFilter.Contains(_invSearchDescription.Trim()));
            hasFilter = true;
        }
        var filter = hasFilter ? filterBuilder : null;

        OrderBuilder<Invitation>? order = null;
        if (_invSortColumn != null && _invSortDirection != null)
        {
            order = _invSortColumn switch
            {
                nameof(Invitation.Email) => Order.For<Invitation>().By(i => i.Email, _invSortDirection.Value),
                nameof(Invitation.Description) => Order.For<Invitation>().By(i => i.Description, _invSortDirection.Value),
                nameof(Invitation.CreatedUtc) => Order.For<Invitation>().By(i => i.CreatedUtc, _invSortDirection.Value),
                nameof(Invitation.ExpiresUtc) => Order.For<Invitation>().By(i => i.ExpiresUtc, _invSortDirection.Value),
                _ => null
            };
        }

        var invResult = await services.GetRequiredService<IInvitationService>().ListInvitationsAsync(
            new ListInvitationsRequest(Id, filter, order, _invitationsSkip, InvitationPageSize, _invStatusFilter)
        );
        if (invResult.ResultCode == RetrieveResultCode.Success && invResult.Data != null)
        {
            _invitations = invResult.Data.Items.ToList();
            _invitationsTotalCount = invResult.Data.TotalCount;
        }
    }

    private async Task OnInvitationPageChangedAsync(int newSkip)
    {
        _invitationsSkip = newSkip;
        await InOperationAsync(LoadInvitationsAsync);
        StateHasChanged();
    }

    private async Task OnInvSearchChangedAsync()
    {
        _invSearchCts?.Cancel();
        _invSearchCts?.Dispose();
        _invSearchCts = new CancellationTokenSource();
        var token = _invSearchCts.Token;

        try
        {
            await Task.Delay(300, token);
            _invitationsSkip = 0;
            await InOperationAsync(LoadInvitationsAsync);
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnInvStatusChangedAsync()
    {
        _invitationsSkip = 0;
        await InOperationAsync(LoadInvitationsAsync);
        StateHasChanged();
    }

    private async Task CycleInvSortAsync(string column)
    {
        if (_invSortColumn != column)
        {
            _invSortColumn = column;
            _invSortDirection = SortDirection.Ascending;
        }
        else if (_invSortDirection == SortDirection.Ascending)
        {
            _invSortDirection = SortDirection.Descending;
        }
        else
        {
            _invSortColumn = null;
            _invSortDirection = null;
        }
        _invitationsSkip = 0;
        await InOperationAsync(LoadInvitationsAsync);
        StateHasChanged();
    }

    private string GetInvSortIcon(string column)
    {
        if (_invSortColumn != column) return "bi-chevron-expand";
        return _invSortDirection == SortDirection.Ascending ? "bi-chevron-up" : "bi-chevron-down";
    }

    private string GetInvSortClass(string column)
    {
        return _invSortColumn == column ? "sortable active" : "sortable";
    }

    private void StartEdit()
    {
        _originalAccountName = _accountName;
        _isEditing = true;
    }

    private void CancelEdit()
    {
        _accountName = _originalAccountName;
        _isEditing = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_accountName)) return;
        await ExecuteSafeAsync(async services =>
        {
            var result = await services.GetRequiredService<IModificationService>().ModifyAccountAsync(new UpdateAccountRequest(Id, _accountName));
            SetResultMessage(result.ResultCode == ModifyResultCode.Success, "Saved.", result.Message);
            if (result.ResultCode == ModifyResultCode.Success)
            {
                _isEditing = false;
                AccountDisplayState.UpdateAccountName(_accountName!);
            }
        });
    }

    private void ConfirmDelete() => _deleteModal.Show();

    private async Task DeleteAsync()
    {
        await ExecuteSafeAsync(async services =>
        {
            var result = await services.GetRequiredService<IDeregistrationService>().DeregisterAccountAsync(new DeregisterAccountRequest(CurrentAccountId));
            if (result.ResultCode == DeregisterAccountResultCode.Success)
            {
                NavigationManager.NavigateTo(Links.Dashboard(), forceLoad: true);
                return;
            }
            SetResultMessage(false, string.Empty, result.Message);
        });
    }

    private void ConfirmRemoveUser(Guid userId, string name) => ShowConfirmation(_removeUserModal, userId, $"Remove user '{name}'?");

    private async Task RemoveUserAsync()
    {
        await ExecuteSafeAsync(async services =>
        {
            var removedUserId = _confirmItemId;
            var currentAccountId = UserContext?.CurrentAccount?.Id;
            var currentUserId = UserContext?.User?.Id;
            if (currentAccountId == null)
                return;

            var result = await services.GetRequiredService<IDeregistrationService>().DeregisterUserFromAccountAsync(
                new DeregisterUserFromAccountRequest(removedUserId, currentAccountId.Value)
            );
            if (result.ResultCode == DeregisterUserFromAccountResultCode.Success
                && removedUserId == currentUserId)
            {
                NavigationManager.NavigateTo(AppRoutes.SelectAccount, forceLoad: true);
                return;
            }
            SetResultMessage(result.ResultCode == DeregisterUserFromAccountResultCode.Success, "User removed.", result.Message ?? "Failed.");
            await ReloadAsync();
        });
    }

    private void ShowCreateInvitation()
    {
        _inviteEmail = string.Empty;
        _inviteDescription = string.Empty;
        _inviteExpirySeconds = CreateInvitationRequest.DEFAULT_EXPIRY_SECONDS;
        _createInvitationModal.Show();
    }

    private async Task CreateInvitationAsync()
    {
        await ExecuteSafeAsync(async services =>
        {
            var request = new CreateInvitationRequest(Id, _inviteEmail!, _inviteDescription, _inviteExpirySeconds);
            var result = await services.GetRequiredService<IInvitationService>().CreateInvitationAsync(request);
            if (result.ResultCode == CreateInvitationResultCode.Success)
            {
                ShowInvitationCreated(request.Email, result);
                SetResultMessage(true, "Invitation created.");
                await ReloadAsync();
            }
            else if (result.ResultCode == CreateInvitationResultCode.UserAlreadyInAccountError)
            {
                SetResultMessage(false, string.Empty, $"{result.Message} User ID: {result.ExistingUserId}");
            }
            else
            {
                SetResultMessage(false, string.Empty, result.Message);
            }
        });
    }

    private void ShowInvitationCreated(string email, CreateInvitationResult result)
    {
        if (result.Delivery == InvitationDeliveryStatus.Sent || result.Token is null)
        {
            _invitationCreatedModal.Show("Invitation sent", @<text>@result.DeliveryMessage</text>);
            return;
        }

        var link = $"{NavigationManager.ToAbsoluteUri(Links.AcceptInvitation().TrimStart('/'))}?token={Uri.EscapeDataString(result.Token)}";
        var failed = result.Delivery == InvitationDeliveryStatus.Failed
            ? $"The invitation could not be sent{(string.IsNullOrWhiteSpace(result.DeliveryMessage) ? "." : $": {result.DeliveryMessage.TrimEnd('.')}.")} "
            : null;
        _invitationCreatedModal.Show(
            failed is null ? "Invitation link" : "Invitation not sent",
            @<text>@failed Send this link to <strong>@email</strong>. It works only when they sign in with that address, and expires <LocalTime Value="result.ExpiresUtc" />.</text>,
            link,
            "Shown once. If it is lost, revoke the invitation and invite again."
        );
    }

    private void ConfirmRevokeInvitation(Guid invitationId, string email) =>
        ShowConfirmation(_revokeInvitationModal, invitationId, $"Revoke invitation for '{email}'?");

    private async Task RevokeInvitationAsync()
    {
        await ExecuteSafeAsync(async services =>
        {
            var result = await services.GetRequiredService<IInvitationService>().RevokeInvitationAsync(new RevokeInvitationRequest(CurrentAccountId, _confirmItemId));
            SetResultMessage(result.ResultCode == RevokeInvitationResultCode.Success, "Invitation revoked.", result.Message);
            await ReloadAsync();
        });
    }

    private string? PublicKeysAddress { get; set; }

    private const string KEYS_DESCRIPTION =
        "This account has its own symmetric and asymmetric encryption keys plus a signing key.";

    // An operation that cannot sign in is already leaving the page; the key panel shows this until it does.
    private const string SESSION_ENDED = "Your session has ended. Sign in again.";

    private async Task<RevealAccountKeyResult> RevealKeyAsync(KeyType keyType, string? currentPassword, string? totpCode) =>
        await InOperationAsync(services =>
            services.GetRequiredService<IRetrievalService>().RevealAccountKeyAsync(new RevealAccountKeyRequest(CurrentAccountId, keyType, currentPassword, totpCode))
        ) ?? new RevealAccountKeyResult(RevealAccountKeyResultCode.UnauthorizedError, SESSION_ENDED);

    private async Task LoadRevealProofAsync(IServiceProvider services)
    {
        var methods = await services.GetRequiredService<IFederatedIdentityService>().GetAuthMethodsAsync();
        var enabled = await services.GetRequiredService<IFederatedSignInService>().ListIdentityProvidersAsync();
        var linked = enabled.Where(p => methods.LinkedIdentities.Any(i => i.Type == p.Type)).ToList();
        _proofProviders = !methods.HasBasicAuth && linked.Count > 0 ? linked : null;
        _canProveIdentity = methods.HasBasicAuth || _proofProviders != null;
    }

    private async Task<ModifyResult> RotateKeyAsync(KeyType keyType)
    {
        var result = await InOperationAsync(async services =>
        {
            var rotated = await services.GetRequiredService<IModificationService>().RotateAccountKeyAsync(new RotateAccountKeyRequest(Id, keyType));
            if (rotated.ResultCode == ModifyResultCode.Success)
                await InOperationAsync(LoadKeyProvidersAsync);
            return rotated;
        }) ?? new ModifyResult(ModifyResultCode.UnauthorizedError, SESSION_ENDED);
        StateHasChanged();
        return result;
    }

    private Task<CompromiseAccountKeyResult> RotateCompromisedKeyAsync(KeyType keyType, string? currentPassword, string? totpCode) =>
        CompromiseKeyAsync(services => services.GetRequiredService<IModificationService>().RotateCompromisedAccountKeyAsync(
            new RotateCompromisedAccountKeyRequest(Id, keyType, new AccountKeyProof(currentPassword, totpCode))
        ));

    private Task<CompromiseAccountKeyResult> MarkKeyCompromisedAsync(KeyType keyType, int version, string? currentPassword, string? totpCode) =>
        CompromiseKeyAsync(services => services.GetRequiredService<IModificationService>().MarkAccountKeyCompromisedAsync(
            new MarkAccountKeyCompromisedRequest(Id, keyType, version, new AccountKeyProof(currentPassword, totpCode))
        ));

    private async Task<CompromiseAccountKeyResult> CompromiseKeyAsync(Func<IServiceProvider, Task<CompromiseAccountKeyResult>> compromise)
    {
        var result = await InOperationAsync(async services =>
        {
            var compromised = await compromise(services);
            if (compromised.ResultCode == CompromiseAccountKeyResultCode.Success)
                await InOperationAsync(LoadKeyProvidersAsync);
            return compromised;
        }) ?? new CompromiseAccountKeyResult(CompromiseAccountKeyResultCode.UnauthorizedError, SESSION_ENDED);
        StateHasChanged();
        return result;
    }

    private async Task LoadKeyProvidersAsync(IServiceProvider services)
    {
        var retrievalService = services.GetRequiredService<IRetrievalService>();
        var symResult = await retrievalService.GetAccountSymmetricEncryptionProviderAsync(Id);
        if (symResult.ResultCode == RetrieveResultCode.Success)
            _symProvider = symResult.Item;

        var asymResult = await retrievalService.GetAccountAsymmetricEncryptionProviderAsync(Id);
        if (asymResult.ResultCode == RetrieveResultCode.Success)
            _asymProvider = asymResult.Item;

        var sigResult = await retrievalService.GetAccountAsymmetricSignatureProviderAsync(Id);
        if (sigResult.ResultCode == RetrieveResultCode.Success)
            _sigProvider = sigResult.Item;
    }
}
