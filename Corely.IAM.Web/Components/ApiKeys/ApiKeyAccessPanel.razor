@inject IResourceTypeRegistry ResourceTypes

<details class="section-divider mb-4 key-access" open="@(!Access.HasUsableAccess)">
    <summary class="section-divider-label key-access-summary">
        This key's access
        <span class="text-muted fw-normal ms-2">@Access.Types.Count(t => t.Allowed) resource types</span>
    </summary>

    @if (!Access.HasUsableAccess)
    {
        <div class="alert alert-warning" role="alert">
            <div><strong>This key can't do anything yet.</strong></div>
            <div>@NothingUsableReason</div>
        </div>
    }

    <div class="mb-3">
        @if (Access.AllowedTypes.Count > 0)
        {
            <div><strong>API keys can be given access to:</strong> @Titles(Access.AllowedTypes)</div>
        }
        <div class="text-muted">A key uses only what its roles and groups grant within that list.</div>
    </div>

    <div class="key-access-grid mb-3">
        @foreach (var type in Access.Types.Where(t => t.Allowed))
        {
            @TypeRow(type)
        }
    </div>

    @if (_ignored.Count > 0)
    {
        <details class="mb-3">
            <summary>
                <span class="badge text-bg-warning">Ignored</span>
                Its roles or groups grant these, but API keys aren't allowed to use them: @Titles(_ignored.Select(t => t.ResourceType))
            </summary>
            <div class="key-access-grid mt-3">
                @foreach (var type in _ignored)
                {
                    @TypeRow(type)
                }
            </div>
        </details>
    }
</details>

@code {
    [Parameter, EditorRequired]
    public Guid AccountId { get; set; }

    [Parameter, EditorRequired]
    public ApiKeyAccess Access { get; set; } = null!;

    private List<ApiKeyTypeAccess> _ignored = [];

    protected override void OnParametersSet() =>
        _ignored = [.. Access.Types.Where(t => !t.Allowed)];

    private string NothingUsableReason =>
        Access.AllowedTypes.Count == 0 ? "The platform doesn't let API keys use any resource types."
        : Access.Types.Count == 0 ? "Give it a role or add it to a group that grants permissions."
        : "Everything its roles and groups grant is outside what the platform allows for API keys.";

    private RenderFragment TypeRow(ApiKeyTypeAccess type) =>
        @<div class="card iam-card key-access-card">
            <div class="card-header"><span class="card-section-title">@Title(type.ResourceType)</span></div>
            <div class="card-body">
                <EffectivePermissionGrants AccountId="AccountId" Permissions="type.Permissions" />
            </div>
        </div>;

    private string Title(string type) => ResourceTypes.Get(type)?.Title ?? type;

    private string Titles(IEnumerable<string> types) => string.Join(", ", types.Select(Title));
}
