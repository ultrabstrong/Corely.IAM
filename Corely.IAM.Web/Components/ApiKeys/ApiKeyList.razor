@inherits EntityListPageBase<ApiKey>
@inject IIamWebLinks Links

<div class="management-header">
    <h1><i class="bi bi-key me-2"></i>API keys</h1>
    <div class="d-flex gap-2 align-items-center">
        <a href="@Links.Dashboard()" class="btn btn-outline-secondary" title="Back to dashboard"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
        @if (_enabled)
        {
            <PermissionView Action="AuthAction.Create" Resource="@ApiKey.RESOURCE_TYPE">
                <button class="btn btn-primary" @onclick="() => _createModal.Show()"><i class="bi bi-plus-lg me-1"></i>Create</button>
            </PermissionView>
        }
    </div>
</div>

<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (!_enabled && !_loading)
{
    <div class="alert alert-info">API keys are switched off for this account in the platform security settings.</div>
}
else if (_items == null)
{
    @if (!_loadFailed)
    {
        <LoadingSpinner />
    }
}
else
{
    <div>
        <table class="table table-striped table-hover table-cards">
            <thead class="list-head">
                <tr>
                    <th class="@GetSortClass(nameof(ApiKey.Name))" @onclick="() => CycleSortAsync(nameof(ApiKey.Name))">
                        <span>Name <i class="bi @(GetSortIcon(nameof(ApiKey.Name))) sort-icon"></i></span>
                        <div class="th-search" @onclick:stopPropagation="true">
                            <input type="text" class="form-control" placeholder="Search..." @bind="_searchText" @bind:event="oninput" @bind:after="OnSearchChangedAsync" />
                        </div>
                    </th>
                    <th>Description</th>
                    <th>Last used</th>
                    <th class="table-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted text-center">No API keys found</td></tr>
                }
                else
                {
                    @foreach (var key in _items)
                    {
                        <tr>
                            <td class="cell-title">
                                @key.Name
                                @if (key.LockedUtc is not null)
                                {
                                    <span class="badge text-bg-warning ms-1">Locked</span>
                                }
                                <br /><CopyableId Value="key.Id" />
                            </td>
                            <td class="@(key.Description is null ? "cell-hide" : "text-muted")">@(key.Description ?? "—")</td>
                            <td class="cell-sub">@(key.LastSuccessfulLoginUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                            <td class="table-actions cell-actions">
                                <div class="row-actions">
                                    <a href="@Links.ApiKey(CurrentAccountId, key.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                    <PermissionView Action="AuthAction.Delete" Resource="@ApiKey.RESOURCE_TYPE" ResourceIds="new[] { key.Id }">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(key.Id, key.Name)" title="Delete"><i class="bi bi-trash"></i></button>
                                    </PermissionView>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <Pagination Skip="_skip" Take="_take" TotalCount="_totalCount" OnPageChanged="OnPageChangedAsync" />
    </div>
}

<FormModal @ref="_createModal" Title="Create API key" OnConfirm="CreateAsync">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" @bind="_newName" placeholder="What the key is for" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <input type="text" class="form-control" @bind="_newDescription" placeholder="Optional" />
    </div>
    <div class="mb-3">
        <label class="form-label">Expires after (days)</label>
        <input type="number" class="form-control" @bind="_newLifetimeDays" min="1" max="@_maxLifetimeDays" />
        <div class="form-text">At most @_maxLifetimeDays days. The key starts with no permissions; assign it roles or groups after creating it.</div>
    </div>
</FormModal>

<ApiKeySecretModal @ref="_newKeyModal" />

<ConfirmModal @ref="_confirmModal" Title="Delete API key" Message="@_confirmMessage" ConfirmText="Delete" OnConfirm="DeleteAsync" />

@code {
    private IRegistrationService RegistrationService => ScopedServices.GetRequiredService<IRegistrationService>();
    private IDeregistrationService DeregistrationService => ScopedServices.GetRequiredService<IDeregistrationService>();
    private IRetrievalService RetrievalService => ScopedServices.GetRequiredService<IRetrievalService>();
    private ISecurityPolicyProvider SecurityPolicyProvider => ScopedServices.GetRequiredService<ISecurityPolicyProvider>();
    private TimeProvider TimeProvider => ScopedServices.GetRequiredService<TimeProvider>();

    private bool _enabled;
    private int _maxLifetimeDays = SecurityPolicy.API_KEY_MAX_LIFETIME_DAYS_DEFAULT;
    private string? _newName;
    private string? _newDescription;
    private int _newLifetimeDays = SecurityPolicy.API_KEY_MAX_LIFETIME_DAYS_DEFAULT;
    private FormModal _createModal = null!;
    private ApiKeySecretModal _newKeyModal = null!;
    private ConfirmModal _confirmModal = null!;

    protected override async Task LoadCoreAsync()
    {
        var policy = await SecurityPolicyProvider.GetPolicyAsync();
        _enabled = policy.AllowsApiKeysIn(UserContext?.CurrentAccount?.IsPlatformAccount == true);
        _maxLifetimeDays = policy.ApiKeyMaxLifetimeDays;
        _newLifetimeDays = Math.Min(_newLifetimeDays, _maxLifetimeDays);
        if (!_enabled)
            return;

        var filter = string.IsNullOrWhiteSpace(_searchText)
            ? null
            : Filter.For<ApiKey>().Where(k => k.Name, StringFilter.Contains(_searchText.Trim()));
        var order = _sortColumn == nameof(ApiKey.Name) && _sortDirection != null
            ? Order.For<ApiKey>().By(k => k.Name, _sortDirection.Value)
            : null;
        var result = await RetrievalService.ListApiKeysAsync(new ListApiKeysRequest(CurrentAccountId, filter, order, _skip, _take));
        if (result.ResultCode == RetrieveResultCode.Success && result.Data != null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            FailLoad(result.ResultCode, "API keys");
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        await ExecuteSafeAsync(async () =>
        {
            var result = await RegistrationService.RegisterApiKeyAsync(new RegisterApiKeyRequest(
                _newName,
                CurrentAccountId,
                _newDescription,
                TimeProvider.GetUtcNow().UtcDateTime.AddDays(Math.Clamp(_newLifetimeDays, 1, _maxLifetimeDays))));
            SetResultMessage(result.ResultCode == CreateApiKeyResultCode.Success, "API key created.", result.Message);
            if (result.Key is not null)
                _newKeyModal.Show(result.Key);
            _newName = null;
            _newDescription = null;
            await ReloadAsync();
        });
    }

    private void ConfirmDelete(Guid id, string name) =>
        ShowConfirmation(_confirmModal, id, $"Delete API key '{name}'? Anything using it stops working at once.");

    private async Task DeleteAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterApiKeyAsync(new DeregisterApiKeyRequest(_confirmItemId, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterApiKeyResultCode.Success, "API key deleted.", result.Message);
            await ReloadAsync();
        });
    }
}
