@inject IJSRuntime JS

@if (_key is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                </div>
                <div class="modal-body">
                    <p>Copy this key now. It is shown only once and cannot be recovered.</p>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" readonly value="@_key" aria-label="New API key" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="CopyAsync" title="Copy">
                            <i class="bi @(_copied ? "bi-check2" : "bi-copy")" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="Close">I have copied it</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Title { get; set; } = "New API key";

    private string? _key;
    private bool _copied;

    public void Show(string key)
    {
        _key = key;
        _copied = false;
        StateHasChanged();
    }

    private void Close() => _key = null;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _key);
            _copied = true;
        }
        catch (JSException)
        {
        }
    }
}
