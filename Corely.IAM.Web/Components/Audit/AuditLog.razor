@inherits EntityListPageBase<AuditEntry>
@inject IIamWebLinks Links
@inject Corely.IAM.Permissions.Providers.IResourceTypeRegistry ResourceTypeRegistry
@inject IJSRuntime JSRuntime

<div class="management-header">
    <h1><i class="bi bi-journal-text me-2"></i>Audit</h1>
    <div class="d-flex gap-2 align-items-center">
        @if (UserContext?.CurrentAccount != null)
        {
            <a href="@Links.Dashboard()" class="btn btn-outline-secondary" title="Back to dashboard"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
        }
        <button class="btn btn-outline-primary" @onclick="ExportAsync" disabled="@_loading"><i class="bi bi-download me-1"></i>Export CSV</button>
        @if (_canPurge)
        {
            <button class="btn btn-outline-danger" @onclick="() => _purgeModal.ShowAsync()" disabled="@_loading"><i class="bi bi-trash me-1"></i>Purge</button>
        }
    </div>
</div>

<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

<div class="row g-2 mb-3 align-items-end">
    <div class="col-12 col-md-3">
        <label class="form-label small mb-1">Account</label>
        <select class="form-select form-select-sm" @bind="_accountFilter" @bind:after="OnFilterChangedAsync">
            <option value="">All accounts I can see</option>
            @foreach (var account in _accounts)
            {
                <option value="@account.Id">@account.Name</option>
            }
            @if (_deletedAccounts.Count > 0)
            {
                <optgroup label="Deleted accounts">
                    @foreach (var account in _deletedAccounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label small mb-1">User id</label>
        <input type="text" class="form-control form-control-sm" placeholder="Any user" @bind="_userFilter" @bind:event="oninput" @bind:after="OnSearchChangedAsync" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Action</label>
        <select class="form-select form-select-sm" @bind="_actionFilter" @bind:after="OnFilterChangedAsync">
            <option value="">Any</option>
            @foreach (var action in Enum.GetValues<AuthAction>())
            {
                <option value="@action">@action</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Resource type</label>
        <select class="form-select form-select-sm" @bind="_resourceTypeFilter" @bind:after="OnFilterChangedAsync">
            <option value="">Any</option>
            @foreach (var type in _resourceTypes)
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-2">
        <label class="form-label small mb-1">Result</label>
        <input type="text" class="form-control form-control-sm" placeholder="Success, Fault..." @bind="_resultFilter" @bind:event="oninput" @bind:after="OnSearchChangedAsync" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small mb-1">From</label>
        <input type="date" class="form-control form-control-sm" @bind="_fromFilter" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChangedAsync" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small mb-1">To</label>
        <input type="date" class="form-control form-control-sm" @bind="_toFilter" @bind:format="yyyy-MM-dd" @bind:after="OnFilterChangedAsync" />
    </div>
    <div class="col-12 col-md-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="includePlatformMembers" @bind="_includePlatformMembers" @bind:after="OnFilterChangedAsync" />
            <label class="form-check-label small" for="includePlatformMembers">Include platform members</label>
        </div>
    </div>
</div>

@if (_items == null)
{
    @if (!_loadFailed)
    {
        <LoadingSpinner />
    }
}
else
{
    <div>
        <div class="table-responsive">
            <table class="table table-striped table-hover table-cards audit-cards">
                <thead class="list-head">
                    <tr>
                        <th><i class="bi bi-clock me-1" aria-hidden="true"></i>When (UTC)</th>
                        <th><i class="bi bi-person me-1" aria-hidden="true"></i>Actor</th>
                        <th><i class="bi bi-building me-1" aria-hidden="true"></i>Account</th>
                        <th>Activity</th>
                        <th><i class="bi bi-lightning me-1" aria-hidden="true"></i>Action</th>
                        <th><i class="bi bi-box me-1" aria-hidden="true"></i>Resource</th>
                        <th>Result</th>
                        <th class="table-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="8"class="text-muted text-center">No audit entries found</td></tr>
                    }
                    else
                    {
                        @foreach (var entry in _items)
                        {
                            <tr>
                                <td class="text-nowrap"><i class="bi bi-clock cell-icon" aria-hidden="true"></i>@entry.OccurredUtc.ToString("yyyy-MM-dd HH:mm:ss")<span class="cell-icon text-body-tertiary ms-1">UTC</span></td>
                                <td>
                                    <i class="bi bi-person cell-icon" aria-hidden="true"></i>@entry.ActorDisplayName()
                                    @if (entry.IsPlatformMember)
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis ms-1">Platform member</span>
                                    }
                                </td>
                                <td><i class="bi bi-building cell-icon" aria-hidden="true"></i>@entry.AccountDisplayName()</td>
                                <td class="cell-title">
                                    @entry.Description()
                                    <span class="cell-only small text-body-tertiary fw-normal ms-1 text-nowrap">via @entry.Source</span>
                                    @if (entry.Details is not null)
                                    {
                                        <div class="small text-body-secondary fw-normal">@entry.Details</div>
                                    }
                                    <div class="small text-body-tertiary fw-normal cell-hide">via @entry.Source</div>
                                </td>
                                <td class="cell-hide"><span class="sys-badge ms-0">@entry.Action</span></td>
                                <td class="cell-hide">
                                    <span class="type-badge ms-0">@entry.ResourceType</span>
                                    @ResourceIds(entry)
                                </td>
                                <td class="cell-only">
                                    <i class="bi bi-lightning cell-icon" aria-hidden="true"></i><span class="sys-badge ms-0">@entry.Action</span>
                                    <i class="bi bi-box cell-icon ms-3" aria-hidden="true"></i><span class="type-badge ms-0">@entry.ResourceType</span>
                                    @ResourceIds(entry)
                                </td>
                                <td class="cell-badge">
                                    <span class="badge rounded-pill @(entry.Succeeded() ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                                        <i class="bi @(entry.Succeeded() ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1" aria-hidden="true"></i>@entry.ResultText()
                                    </span>
                                </td>
                                <td class="table-actions cell-actions">
                                    <div class="row-actions">
                                        <a href="@Links.AuditEntry(CurrentAccountId, entry.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Pagination Skip="_skip" Take="_take" TotalCount="_totalCount" OnPageChanged="OnPageChangedAsync" />
    </div>
}

<AuditPurgeModal @ref="_purgeModal" OnPurged="OnPurgedAsync" />

@code {
    private const string CSV_MIME_TYPE = "text/csv";
    private const int SHOWN_RESOURCE_IDS = 3;

    private RenderFragment ResourceIds(AuditEntry entry) =>
        @<text>
            @foreach (var id in entry.ShownResourceIds(SHOWN_RESOURCE_IDS))
            {
                <div><CopyableId Value="id" /></div>
            }
            @if (entry.HiddenResourceIdCount(SHOWN_RESOURCE_IDS) is > 0 and var hidden)
            {
                <div><small class="text-muted">and @hidden more</small></div>
            }
        </text>;

    private IAuditService AuditService => ScopedServices.GetRequiredService<IAuditService>();

    private List<AuditAccountOption> _accounts = [];
    private List<AuditAccountOption> _deletedAccounts = [];
    private List<string> _resourceTypes = [];
    private bool _canPurge;
    private Guid? _accountFilter;
    private string _userFilter = string.Empty;
    private AuthAction? _actionFilter;
    private string? _resourceTypeFilter;
    private string _resultFilter = string.Empty;
    private DateTime? _fromFilter;
    private DateTime? _toFilter;
    private bool _includePlatformMembers = true;
    private bool _optionsLoaded;
    private AuditPurgeModal _purgeModal = null!;
    private IJSObjectReference? _downloadModule;

    protected override async Task LoadCoreAsync()
    {
        if (!_optionsLoaded)
        {
            await LoadOptionsAsync();
        }

        var result = await AuditService.ListEntriesAsync(new ListAuditEntriesRequest(BuildFilter(), _skip, _take));
        if (result.ResultCode == RetrieveResultCode.Success && result.Data != null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            FailLoad(result.ResultCode, "the audit log");
        }
    }

    private async Task LoadOptionsAsync()
    {
        var readable = await AuditService.ListAuditAccountsAsync(AuthAction.Read);
        _accounts = [.. readable.Accounts];
        _deletedAccounts = [.. readable.DeletedAccounts];
        var purgeable = await AuditService.ListAuditAccountsAsync(AuthAction.Delete);
        _canPurge = purgeable.IncludesEverything || purgeable.Accounts.Count > 0;
        _resourceTypes = [.. ResourceTypeRegistry.GetAll().Select(t => t.Name).Order()];
        _optionsLoaded = true;
    }

    private AuditEntryFilter BuildFilter() =>
        new()
        {
            AccountId = _accountFilter,
            ActorUserId = Guid.TryParse(_userFilter.Trim(), out var userId) ? userId : null,
            Action = _actionFilter,
            ResourceType = string.IsNullOrWhiteSpace(_resourceTypeFilter) ? null : _resourceTypeFilter,
            ResultCode = string.IsNullOrWhiteSpace(_resultFilter) ? null : _resultFilter.Trim(),
            FromUtc = _fromFilter?.StartOfDayUtc(),
            ToUtc = _toFilter?.EndOfDayUtc(),
            IncludePlatformMembers = _includePlatformMembers,
        };

    private async Task OnFilterChangedAsync()
    {
        _skip = 0;
        await ReloadAsync();
    }

    private async Task ExportAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await AuditService.ExportEntriesAsync(BuildFilter());
            if (result.ResultCode != RetrieveResultCode.Success || result.Csv is null)
            {
                SetResultMessage(false, string.Empty, "The audit log couldn't be exported.");
                return;
            }

            _downloadModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Corely.IAM.Web/js/file-download.js"
            );
            await _downloadModule.InvokeVoidAsync(
                "downloadText",
                $"audit-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv",
                result.Csv,
                CSV_MIME_TYPE
            );

            _message = result.Truncated ? result.Message : $"Exported {result.ExportedCount} entries.";
            _messageType = result.Truncated ? AlertType.Warning : AlertType.Success;
        });
    }

    private async Task OnPurgedAsync(int count)
    {
        SetResultMessage(true, $"Purged {count} audit entries.");
        _skip = 0;
        await ReloadAsync();
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        await base.DisposeAsyncCore();
        if (_downloadModule is not null)
        {
            try
            {
                await _downloadModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
