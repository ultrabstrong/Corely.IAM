@inherits EntityDetailPageBase
@inject IIamWebLinks Links

<div class="management-header">
    <h1><i class="bi bi-diagram-3 me-2"></i>@(_group?.Name ?? "Group") <span class="resource-label">Group</span></h1>
    <a href="@Links.Groups(CurrentAccountId)" class="btn btn-outline-secondary">Back to Groups</a>
</div>

<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (_loading && _group == null)
{
    <LoadingSpinner />
}
else if (_group == null)
{
    <div class="alert alert-warning">Group not found.</div>
}
else
{
    <div class="detail-section">

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Details
                @if (!_isEditing)
                {
                    <div class="d-flex gap-2">
                        <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                            <button class="btn btn-outline-primary btn-sm" @onclick="StartEdit">Edit</button>
                        </PermissionView>
                        <PermissionView Action="AuthAction.Delete" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                            <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDelete" disabled="@_loading">Delete</button>
                        </PermissionView>
                    </div>
                }
                else if (_isEditing)
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="SavePropertiesAsync" disabled="@_loading">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                    </div>
                }
            </div>
            @if (_isEditing)
            {
                <div class="props-grid mb-3">
                    <span class="prop-label">Name</span>
                    <div class="prop-value"><input type="text" class="form-control form-control-sm" @bind="_editName" /></div>
                    <span class="prop-label">Description</span>
                    <div class="prop-value"><input type="text" class="form-control form-control-sm" @bind="_editDescription" placeholder="Optional" /></div>
                </div>
            }
            else
            {
                <div class="props-grid">
                    <span class="prop-label cell-hide">Name</span>
                    <span class="prop-value cell-title">@_group.Name</span>
                    <span class="prop-label cell-hide">Description</span>
                    <span class="prop-value cell-sub @(_group.Description is null ? "cell-hide" : null)">@(_group.Description ?? "—")</span>
                </div>
            }
        </div>

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Users
                <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                    @if (_canAddUsers)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => _userPickerModal.ShowAsync()" disabled="@_loading">Add Users</button>
                    }
                </PermissionView>
            </div>
            <table class="table table-striped table-hover table-cards mb-0">
                <thead class="list-head"><tr><th>Name</th><th class="table-actions">Actions</th></tr></thead>
                <tbody>
                    @if (_group.Users == null || _group.Users.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted text-center">No users assigned</td></tr>
                    }
                    else
                    {
                        @foreach (var user in PagedUsers)
                        {
                            <tr>
                                <td class="cell-title">
                                    @user.Name
                                    <br /><CopyableId Value="user.Id" />
                                </td>
                                <td class="table-actions cell-actions">
                                    <div class="row-actions">
                                        <a href="@Links.User(CurrentAccountId, user.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                        <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRemoveUser(user.Id, user.Name)" title="Remove"><i class="bi bi-trash"></i></button>
                                        </PermissionView>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <Pagination Skip="_usersSkip" Take="@RelationPageSize" TotalCount="@UsersTotalCount"
                        OnPageChanged="newSkip => { _usersSkip = newSkip; StateHasChanged(); }" />
        </div>

        @if (_showApiKeys)
        {
            <div class="section-divider mb-4">
                <div class="section-divider-label">
                    API keys
                    <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                        @if (_canAddUsers)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => _apiKeyPickerModal.ShowAsync()" disabled="@_loading">Add API keys</button>
                        }
                    </PermissionView>
                </div>
                <table class="table table-striped table-hover table-cards mb-0">
                    <thead class="list-head"><tr><th>Name</th><th class="table-actions">Actions</th></tr></thead>
                    <tbody>
                        @if (_group.ApiKeys == null || _group.ApiKeys.Count == 0)
                        {
                            <tr><td colspan="2" class="text-muted text-center">No API keys assigned</td></tr>
                        }
                        else
                        {
                            @foreach (var apiKey in PagedApiKeys)
                            {
                                <tr>
                                    <td class="cell-title">
                                        @apiKey.Name
                                        <br /><CopyableId Value="apiKey.Id" />
                                    </td>
                                    <td class="table-actions cell-actions">
                                        <div class="row-actions">
                                            <a href="@Links.ApiKey(CurrentAccountId, apiKey.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                            <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRemoveApiKey(apiKey.Id, apiKey.Name)" title="Remove"><i class="bi bi-trash"></i></button>
                                            </PermissionView>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <Pagination Skip="_apiKeysSkip" Take="@RelationPageSize" TotalCount="@ApiKeysTotalCount"
                            OnPageChanged="newSkip => { _apiKeysSkip = newSkip; StateHasChanged(); }" />
            </div>
        }

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Roles
                <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                    <button class="btn btn-primary btn-sm" @onclick="() => _rolePickerModal.ShowAsync()" disabled="@_loading">Add Roles</button>
                </PermissionView>
            </div>
            <table class="table table-striped table-hover table-cards mb-0">
                <thead class="list-head"><tr><th>Name</th><th class="table-actions">Actions</th></tr></thead>
                <tbody>
                    @if (_group.Roles == null || _group.Roles.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted text-center">No roles assigned</td></tr>
                    }
                    else
                    {
                        @foreach (var role in PagedRoles)
                        {
                            <tr>
                                <td class="cell-title">
                                    @role.Name
                                    <br /><CopyableId Value="role.Id" />
                                </td>
                                <td class="table-actions cell-actions">
                                    <div class="row-actions">
                                        <a href="@Links.Role(CurrentAccountId, role.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                        <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRemoveRole(role.Id, role.Name)" title="Remove"><i class="bi bi-trash"></i></button>
                                        </PermissionView>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <Pagination Skip="_rolesSkip" Take="@RelationPageSize" TotalCount="@RolesTotalCount"
                        OnPageChanged="newSkip => { _rolesSkip = newSkip; StateHasChanged(); }" />
        </div>

        <EffectivePermissionsPanel AccountId="CurrentAccountId" Permissions="_effectivePermissions" UseCard="false" />

    </div>
}

<EntityPickerModal @ref="_userPickerModal"
                   Title="Add Users to Group"
                   SearchPlaceholder="Search users..."
                   FetchItemsAsync="FetchAvailableUsersAsync"
                   ExcludeIds="_assignedUserIds"
                   OnConfirm="AddUsersAsync" />

<EntityPickerModal @ref="_rolePickerModal"
                   Title="Add Roles to Group"
                   SearchPlaceholder="Search roles..."
                   FetchItemsAsync="FetchAvailableRolesAsync"
                   ExcludeIds="_hiddenRoleIds"
                   OnConfirm="AddRolesAsync" />

<EntityPickerModal @ref="_apiKeyPickerModal"
                   Title="Add API keys to Group"
                   SearchPlaceholder="Search API keys..."
                   FetchItemsAsync="FetchAvailableApiKeysAsync"
                   ExcludeIds="_assignedApiKeyIds"
                   OnConfirm="AddApiKeysAsync" />

<ConfirmModal @ref="_removeApiKeyModal" Title="Remove API key" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveApiKeyAsync" />
<ConfirmModal @ref="_removeUserModal" Title="Remove User" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveUserAsync" />
<ConfirmModal @ref="_removeRoleModal" Title="Remove Role" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveRoleAsync" />
<ConfirmModal @ref="_deleteModal" Title="Delete Group" Message="@($"Permanently delete group '{_group?.Name}'? This cannot be undone.")" ConfirmText="Delete" OnConfirm="DeleteAsync" />

@code {
    private IRetrievalService RetrievalService => ScopedServices.GetRequiredService<IRetrievalService>();
    private IModificationService ModificationService => ScopedServices.GetRequiredService<IModificationService>();
    private IRegistrationService RegistrationService => ScopedServices.GetRequiredService<IRegistrationService>();
    private IDeregistrationService DeregistrationService => ScopedServices.GetRequiredService<IDeregistrationService>();
    private IAuthorizationProvider AuthorizationProvider => ScopedServices.GetRequiredService<IAuthorizationProvider>();
    private ISecurityPolicyProvider SecurityPolicyProvider => ScopedServices.GetRequiredService<ISecurityPolicyProvider>();

    private Group? _group;
    private string _editName = string.Empty;
    private string? _editDescription;
    private string _originalName = string.Empty;
    private string? _originalDescription;
    private bool _isEditing;
    private List<EffectivePermission>? _effectivePermissions;
    private EntityPickerModal _userPickerModal = null!;
    private EntityPickerModal _rolePickerModal = null!;
    private EntityPickerModal _apiKeyPickerModal = null!;
    private ConfirmModal _removeApiKeyModal = null!;
    private HashSet<Guid> _assignedApiKeyIds = [];
    private bool _showApiKeys;
    private int _apiKeysSkip;
    private List<ChildRef> PagedApiKeys => (_group?.ApiKeys ?? []).Skip(_apiKeysSkip).Take(RelationPageSize).ToList();
    private int ApiKeysTotalCount => _group?.ApiKeys?.Count ?? 0;
    private ConfirmModal _removeUserModal = null!;
    private ConfirmModal _removeRoleModal = null!;
    private ConfirmModal _deleteModal = null!;
    private HashSet<Guid> _assignedUserIds = [];
    private HashSet<Guid> _assignedRoleIds = [];
    private HashSet<Guid> _hiddenRoleIds = [];
    private bool _canAddUsers;

    private int _usersSkip;
    private int _rolesSkip;
    private const int RelationPageSize = 10;
    private List<ChildRef> PagedUsers => (_group?.Users ?? []).Skip(_usersSkip).Take(RelationPageSize).ToList();
    private int UsersTotalCount => _group?.Users?.Count ?? 0;
    private List<ChildRef> PagedRoles => (_group?.Roles ?? []).Skip(_rolesSkip).Take(RelationPageSize).ToList();
    private int RolesTotalCount => _group?.Roles?.Count ?? 0;

    protected override async Task LoadCoreAsync()
    {
        var result = await RetrievalService.GetGroupAsync(Id, hydrate: true);
        if (result.ResultCode == RetrieveResultCode.Success && result.Item != null)
        {
            _group = result.Item;
            _editName = _group.Name;
            _editDescription = _group.Description;
            _assignedUserIds = (_group.Users ?? []).Select(u => u.Id).ToHashSet();
            _assignedRoleIds = (_group.Roles ?? []).Select(r => r.Id).ToHashSet();
            _hiddenRoleIds = [.. _assignedRoleIds];
            _canAddUsers = await AuthorizationProvider.CanGrantGroupAsync(Id);
            _assignedApiKeyIds = (_group.ApiKeys ?? []).Select(k => k.Id).ToHashSet();
            _showApiKeys = (await SecurityPolicyProvider.GetPolicyAsync()).AllowsApiKeysIn(UserContext?.CurrentAccount?.IsPlatformAccount == true)
                && await AuthorizationProvider.IsAuthorizedAsync(AuthAction.Read, ApiKey.RESOURCE_TYPE);
            _effectivePermissions = result.EffectivePermissions;
        }
    }

    private void ConfirmDelete() => _deleteModal.Show();

    private async Task DeleteAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterGroupAsync(new DeregisterGroupRequest(Id, CurrentAccountId));
            if (result.ResultCode == DeregisterGroupResultCode.Success)
            {
                NavigationManager.NavigateTo(Links.Groups(CurrentAccountId));
                return;
            }
            SetResultMessage(false, string.Empty, result.Message);
        });
    }

    private void StartEdit()
    {
        _originalName = _editName;
        _originalDescription = _editDescription;
        _isEditing = true;
    }

    private void CancelEdit()
    {
        _editName = _originalName;
        _editDescription = _originalDescription;
        _isEditing = false;
    }

    private async Task<(List<PickerItem>, int)> FetchAvailableUsersAsync(int skip, int take)
    {
        var result = await RetrievalService.ListUsersAsync(new ListUsersRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode == RetrieveResultCode.Success && result.Data != null)
        {
            var items = result.Data.Items.Select(u => new PickerItem(u.Id, u.Username, u.Email)).ToList();
            return (items, result.Data.TotalCount);
        }
        return ([], 0);
    }

    private async Task<(List<PickerItem>, int)> FetchAvailableRolesAsync(int skip, int take)
    {
        var result = await RetrievalService.ListRolesAsync(new ListRolesRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode == RetrieveResultCode.Success && result.Data != null)
        {
            var grantable = await AuthorizationProvider.GetGrantableRoleIdsAsync(result.Data.Items.Select(x => x.Id));
            _hiddenRoleIds.UnionWith(result.Data.Items.Select(x => x.Id).Where(id => !grantable.Contains(id)));
            var items = result.Data.Items.Select(r => new PickerItem(r.Id, r.Name, r.Description)).ToList();
            return (items, result.Data.TotalCount);
        }
        return ([], 0);
    }

    private async Task SavePropertiesAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        await ExecuteSafeAsync(async () =>
        {
            var result = await ModificationService.ModifyGroupAsync(new UpdateGroupRequest(Id, CurrentAccountId, _editName, _editDescription));
            SetResultMessage(result.ResultCode == ModifyResultCode.Success, "Group updated.", result.Message);
            if (result.ResultCode == ModifyResultCode.Success)
            {
                _isEditing = false;
                await ReloadAsync();
            }
        });
    }

    private async Task AddUsersAsync(List<Guid> userIds)
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await RegistrationService.RegisterUsersWithGroupAsync(new RegisterUsersWithGroupRequest(userIds, Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == AddUsersToGroupResultCode.Success, $"{userIds.Count} user(s) added.", result.Message);
            await ReloadAsync();
        });
    }

    private void ConfirmRemoveUser(Guid userId, string name) => ShowConfirmation(_removeUserModal, userId, $"Remove user '{name}'?");

    private async Task RemoveUserAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterUsersFromGroupAsync(new DeregisterUsersFromGroupRequest([_confirmItemId], Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterUsersFromGroupResultCode.Success, "User removed.", result.Message);
            await ReloadAsync();
        });
    }

    private async Task<(List<PickerItem>, int)> FetchAvailableApiKeysAsync(int skip, int take)
    {
        var result = await RetrievalService.ListApiKeysAsync(new ListApiKeysRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode == RetrieveResultCode.Success && result.Data != null)
        {
            var items = result.Data.Items.Select(k => new PickerItem(k.Id, k.Name, k.Description)).ToList();
            return (items, result.Data.TotalCount);
        }
        return ([], 0);
    }

    private async Task AddApiKeysAsync(List<Guid> apiKeyIds)
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await RegistrationService.RegisterApiKeysWithGroupAsync(new RegisterApiKeysWithGroupRequest(apiKeyIds, Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == AddApiKeysToGroupResultCode.Success, $"{apiKeyIds.Count} API key(s) added.", result.Message);
            await ReloadAsync();
        });
    }

    private void ConfirmRemoveApiKey(Guid apiKeyId, string name) => ShowConfirmation(_removeApiKeyModal, apiKeyId, $"Remove API key '{name}'?");

    private async Task RemoveApiKeyAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterApiKeysFromGroupAsync(new DeregisterApiKeysFromGroupRequest([_confirmItemId], Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterApiKeysFromGroupResultCode.Success, "API key removed.", result.Message);
            await ReloadAsync();
        });
    }

    private async Task AddRolesAsync(List<Guid> roleIds)
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await RegistrationService.RegisterRolesWithGroupAsync(new RegisterRolesWithGroupRequest(roleIds, Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == AssignRolesToGroupResultCode.Success, $"{roleIds.Count} role(s) added.", result.Message);
            await ReloadAsync();
        });
    }

    private void ConfirmRemoveRole(Guid roleId, string name) => ShowConfirmation(_removeRoleModal, roleId, $"Remove role '{name}'?");

    private async Task RemoveRoleAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterRolesFromGroupAsync(new DeregisterRolesFromGroupRequest([_confirmItemId], Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterRolesFromGroupResultCode.Success, "Role removed.", result.Message);
            await ReloadAsync();
        });
    }
}
