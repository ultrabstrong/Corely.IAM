@inherits AuthenticatedPageBase
@inject IIamWebLinks Links
@inject IJSRuntime JS

<div class="d-flex justify-content-center align-items-center mt-5">
    <div class="card iam-card border-0 shadow" style="max-width: 500px; width: 100%;">
        <div class="card-body p-4 text-center">
            <i class="bi bi-envelope-open fs-1 text-primary"></i>
            <h3 class="mt-3">@(_fromLink ? "You've been invited" : "Accept Invitation")</h3>
            @if (_fromLink)
            {
                <p class="text-muted">
                    Accept to join the account. The invitation works only for the address it was sent to;
                    you are signed in as <strong>@UserContext?.User?.Email</strong>.
                </p>
            }
            else
            {
                <p class="text-muted">Paste your invitation token below to join an account.</p>
            }

            <Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

            @if (_fromLink)
            {
                <button class="btn btn-primary mt-3" @onclick="AcceptAsync" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Accept invitation
                </button>
            }
            else
            {
                <div class="input-group mt-3">
                    <input type="text" class="form-control" @bind="_token" placeholder="Invitation token" disabled="@_loading" />
                    <button class="btn btn-primary" @onclick="AcceptAsync" disabled="@_loading">
                        @if (_loading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Accept
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <a href="@AppRoutes.SelectAccount" data-enhance-nav="false">Back to accounts</a>
</div>

@code {

    private string? _token;
    private bool _fromLink;
    private string? _message;
    private AlertType _messageType = AlertType.Info;
    private bool _loading;

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    protected override Task OnInitializedAuthenticatedAsync(IServiceProvider services)
    {
        if (!string.IsNullOrWhiteSpace(TokenParam))
        {
            _token = TokenParam;
            _fromLink = true;
        }
        return Task.CompletedTask;
    }

    // The token is a secret: once read, it leaves the address bar, so it is not left in history
    // or copied along with the address.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_fromLink)
            return;
        try
        {
            await JS.InvokeVoidAsync("history.replaceState", null, "", new Uri(NavigationManager.Uri).AbsolutePath);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task AcceptAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            var token = _token?.Trim();
            if (string.IsNullOrWhiteSpace(token))
            {
                _messageType = AlertType.Warning;
                _message = "Invitation token is required.";
                return;
            }

            var result = await InOperationAsync(services =>
                services.GetRequiredService<IInvitationService>().AcceptInvitationAsync(new AcceptInvitationRequest(token))
            );
            if (result is null)
                return;
            if (result.ResultCode == AcceptInvitationResultCode.Success && result.AccountId != null)
            {
                NavigationManager.NavigateTo(
                    $"{AppRoutes.SwitchAccount}?accountId={result.AccountId}&returnUrl={Uri.EscapeDataString(Links.Dashboard())}",
                    forceLoad: true
                );
                return;
            }

            _message = result.ResultCode switch
            {
                AcceptInvitationResultCode.InvitationExpiredError => "This invitation has expired. Ask for a new one.",
                AcceptInvitationResultCode.InvitationRevokedError => "This invitation has been revoked.",
                AcceptInvitationResultCode.InvitationAlreadyAcceptedError => "This invitation has already been used.",
                AcceptInvitationResultCode.InvitationNotFoundError => _fromLink
                    ? "Invitation not found. Check that you opened the whole link."
                    : "Invitation not found. Check the token and try again.",
                AcceptInvitationResultCode.EmailMismatchError =>
                    $"This invitation is for a different email address. You are signed in as {UserContext?.User?.Email}.",
                _ => result.Message
            };
            _messageType = AlertType.Danger;
        }
        catch
        {
            _message = "An unexpected error occurred. Please try again.";
            _messageType = AlertType.Danger;
        }
        finally
        {
            _loading = false;
        }
    }
}
