@page "/permissions"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits EntityListPageBase<Permission>
@inject IRetrievalService RetrievalService
@inject IRegistrationService RegistrationService
@inject IDeregistrationService DeregistrationService
@inject IAuthorizationProvider AuthorizationProvider
@inject Corely.IAM.Permissions.Providers.IResourceTypeRegistry ResourceTypeRegistry

<PageTitle>Permissions - Corely IAM</PageTitle>

<div class="management-header">
    <h1><i class="bi bi-key me-2"></i>Permissions</h1>
    <div class="d-flex gap-2 align-items-center">
        <a href="@AppRoutes.Dashboard" class="btn btn-outline-secondary" title="Back to dashboard"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
        <PermissionView Action="AuthAction.Create" Resource="@PermissionConstants.PERMISSION_RESOURCE_TYPE">
            <button class="btn btn-primary" @onclick="() => _createModal.Show()"><i class="bi bi-plus-lg me-1"></i>Create</button>
        </PermissionView>
    </div>
</div>

<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (_items == null)
{
    @if (!_loadFailed)
    {
        <LoadingSpinner />
    }
}
else
{
    <div>
        <table class="table table-striped table-hover table-cards">
            <thead class="table-dark">
                <tr>
                    <th class="@GetSortClass(nameof(Permission.Description))" @onclick="() => CycleSortAsync(nameof(Permission.Description))">
                        <span>Permission <i class="bi @(GetSortIcon(nameof(Permission.Description))) sort-icon"></i></span>
                        <div class="th-search" @onclick:stopPropagation="true">
                            <input type="text" class="form-control"
                                   placeholder="Search..."
                                   @bind="_searchText"
                                   @bind:event="oninput"
                                   @bind:after="OnSearchChangedAsync" />
                        </div>
                    </th>
                    <th>Resource ID</th>
                    <th>C</th>
                    <th>R</th>
                    <th>U</th>
                    <th>D</th>
                    <th>X</th>
                    <th class="table-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr><td colspan="8" class="text-muted text-center">No permissions found</td></tr>
                }
                else
                {
                    @foreach (var perm in _items)
                    {
                        <tr>
                            <td class="cell-title">
                                @(perm.Description ?? perm.DisplayName)
                                <span class="type-badge">@perm.ResourceType</span>
                                @if (perm.IsSystemDefined)
                                {
                                    <span class="sys-badge">System</span>
                                }
                                <br /><small class="guid-text">@perm.Id</small>
                            </td>
                            <td class="cell-hide"><code>@(perm.ResourceId == Guid.Empty ? "all" : perm.ResourceId)</code></td>
                            <td class="cell-hide"><span class="permission-badge @(perm.Create ? "active" : "inactive")">C</span></td>
                            <td class="cell-hide"><span class="permission-badge @(perm.Read ? "active" : "inactive")">R</span></td>
                            <td class="cell-hide"><span class="permission-badge @(perm.Update ? "active" : "inactive")">U</span></td>
                            <td class="cell-hide"><span class="permission-badge @(perm.Delete ? "active" : "inactive")">D</span></td>
                            <td class="cell-hide"><span class="permission-badge @(perm.Execute ? "active" : "inactive")">X</span></td>
                            <td class="cell-only">
                                <span class="permission-badge @(perm.Create ? "active" : "inactive")">C</span>
                                <span class="permission-badge @(perm.Read ? "active" : "inactive")">R</span>
                                <span class="permission-badge @(perm.Update ? "active" : "inactive")">U</span>
                                <span class="permission-badge @(perm.Delete ? "active" : "inactive")">D</span>
                                <span class="permission-badge @(perm.Execute ? "active" : "inactive")">X</span>
                                <code class="ms-2">@(perm.ResourceId == Guid.Empty ? "all" : perm.ResourceId)</code>
                            </td>
                            <td class="table-actions cell-actions">
                                <div class="row-actions">
                                    <a href="@AppRoutes.Permissions/@perm.Id" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                    @if (!perm.IsSystemDefined)
                                    {
                                        <PermissionView Action="AuthAction.Delete" Resource="@PermissionConstants.PERMISSION_RESOURCE_TYPE" ResourceIds="new[] { perm.Id }">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(perm.Id, perm.DisplayName)" title="Delete"><i class="bi bi-trash"></i></button>
                                        </PermissionView>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <Pagination Skip="_skip" Take="_take" TotalCount="_totalCount" OnPageChanged="OnPageChangedAsync" />
    </div>
}

<FormModal @ref="_createModal" Title="Create Permission" OnConfirm="CreateAsync">
    <div class="mb-3">
        <label class="form-label">Resource Type</label>
        <select class="form-select" value="@_newResourceType" @onchange="OnResourceTypeChangedAsync">
            <option value="">-- Select --</option>
            @foreach (var rt in _grantableResourceTypes)
            {
                <option value="@rt.Name">@rt.Description</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Resource ID</label>
        <input type="text" class="form-control" @bind="_newResourceId" @bind:after="RefreshGrantableActionsAsync" placeholder="GUID (empty = all)" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <input type="text" class="form-control" @bind="_newDescription" placeholder="Optional" />
    </div>
    <div class="d-flex gap-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkCreate" @bind="_newCreate" disabled="@(!_grantableActions.Contains(AuthAction.Create))" />
            <label class="form-check-label" for="chkCreate">Create</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkRead" @bind="_newRead" disabled="@(!_grantableActions.Contains(AuthAction.Read))" />
            <label class="form-check-label" for="chkRead">Read</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkUpdate" @bind="_newUpdate" disabled="@(!_grantableActions.Contains(AuthAction.Update))" />
            <label class="form-check-label" for="chkUpdate">Update</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkDelete" @bind="_newDelete" disabled="@(!_grantableActions.Contains(AuthAction.Delete))" />
            <label class="form-check-label" for="chkDelete">Delete</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkExecute" @bind="_newExecute" disabled="@(!_grantableActions.Contains(AuthAction.Execute))" />
            <label class="form-check-label" for="chkExecute">Execute</label>
        </div>
    </div>
</FormModal>

<ConfirmModal @ref="_confirmModal" Title="Delete Permission" Message="@_confirmMessage" ConfirmText="Delete" OnConfirm="DeleteAsync" />

@code {
    private string? _newResourceType;
    private string? _newResourceId;
    private string? _newDescription;
    private bool _newCreate;
    private bool _newRead;
    private bool _newUpdate;
    private bool _newDelete;
    private bool _newExecute;
    private FormModal _createModal = null!;
    private ConfirmModal _confirmModal = null!;
    private IReadOnlyCollection<ResourceTypeInfo> _resourceTypes = [];
    private List<ResourceTypeInfo> _grantableResourceTypes = [];
    private IReadOnlySet<AuthAction> _grantableActions = new HashSet<AuthAction>();

    protected override async Task LoadCoreAsync()
    {
        if (_resourceTypes.Count == 0)
        {
            _resourceTypes = ResourceTypeRegistry.GetAll();
            foreach (var rt in _resourceTypes)
            {
                if ((await AuthorizationProvider.GetGrantableActionsAsync(rt.Name, Guid.Empty)).Count > 0)
                    _grantableResourceTypes.Add(rt);
            }
        }

        FilterBuilder<Permission>? filter = null;
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            filter = Filter.For<Permission>()
                .Where(p => p.Description!, StringFilter.Contains(_searchText.Trim()));
        }
        OrderBuilder<Permission>? order = null;
        if (_sortColumn != null && _sortDirection != null)
        {
            order = _sortColumn switch
            {
                nameof(Permission.Description) => Order.For<Permission>().By(p => p.Description!, _sortDirection.Value),
                _ => null
            };
        }
        var result = await RetrievalService.ListPermissionsAsync(new ListPermissionsRequest(UserContext!.CurrentAccount!.Id, filter, order, _skip, _take));
        if (result.ResultCode == RetrieveResultCode.Success && result.Data != null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
    }

    private async Task OnResourceTypeChangedAsync(ChangeEventArgs e)
    {
        _newResourceType = e.Value?.ToString();
        await RefreshGrantableActionsAsync();
    }

    private async Task RefreshGrantableActionsAsync()
    {
        _grantableActions = string.IsNullOrWhiteSpace(_newResourceType)
            ? new HashSet<AuthAction>()
            : await AuthorizationProvider.GetGrantableActionsAsync(
                _newResourceType,
                Guid.TryParse(_newResourceId, out var parsed) ? parsed : Guid.Empty);
        _newCreate &= _grantableActions.Contains(AuthAction.Create);
        _newRead &= _grantableActions.Contains(AuthAction.Read);
        _newUpdate &= _grantableActions.Contains(AuthAction.Update);
        _newDelete &= _grantableActions.Contains(AuthAction.Delete);
        _newExecute &= _grantableActions.Contains(AuthAction.Execute);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newResourceType)) return;
        var resourceId = Guid.TryParse(_newResourceId, out var parsed) ? parsed : Guid.Empty;
        await ExecuteSafeAsync(async () =>
        {
            var result = await RegistrationService.RegisterPermissionAsync(
                new RegisterPermissionRequest(UserContext!.CurrentAccount!.Id, _newResourceType, resourceId, _newCreate, _newRead, _newUpdate, _newDelete, _newExecute, string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim()));
            SetResultMessage(result.ResultCode == CreatePermissionResultCode.Success, "Permission created.", result.Message);
            ResetCreateForm();
            await ReloadAsync();
        });
    }

    private void ResetCreateForm()
    {
        _newResourceType = string.Empty;
        _newResourceId = string.Empty;
        _newDescription = string.Empty;
        _newCreate = false;
        _newRead = false;
        _newUpdate = false;
        _newDelete = false;
        _newExecute = false;
        _grantableActions = new HashSet<AuthAction>();
    }

    private void ConfirmDelete(Guid id, string name)
    {
        if (_loading) return;
        ShowConfirmation(_confirmModal, id, $"Delete permission '{name}'?");
    }

    private async Task DeleteAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterPermissionAsync(new DeregisterPermissionRequest(_confirmItemId, UserContext!.CurrentAccount!.Id));
            SetResultMessage(result.ResultCode == DeregisterPermissionResultCode.Success, "Permission deleted.", result.Message);
            await ReloadAsync();
        });
    }
}
