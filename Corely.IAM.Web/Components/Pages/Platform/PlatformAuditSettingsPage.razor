@page "/platform-settings/audit"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits EntityPageBase

<PageTitle>Audit Settings - Corely IAM</PageTitle>

<PlatformSettingsFrame>
<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (_settings is null)
{
    @if (!_loadFailed)
    {
        <LoadingSpinner />
    }
}
else
{
    <div class="section-divider mb-4">
        <div class="section-divider-label">
            Audit
            @if (!_isEditing && _canUpdate)
            {
                <button class="btn btn-outline-primary btn-sm" @onclick="() => _isEditing = true">Edit</button>
            }
            else if (_isEditing)
            {
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="RequestSave" disabled="@_loading">Save</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit" disabled="@_loading">Cancel</button>
                </div>
            }
        </div>
        <div class="settings-grid mb-3">
            <span class="prop-label">Auditing</span>
            <div class="setting-wide">
                <ToggleSetting Id="auditEnabled" Label="Auditing" LabelWhenReadOnly="false" @bind-Value="_auditEnabled" Editing="_isEditing" />
            </div>
            <NumberSetting Label="Maximum retention (days)" @bind-Value="_maxRetentionDays" Editing="_isEditing" Min="0" />
        </div>
        <AuditActionMatrix>
            <AuditActionRow IdPrefix="platform-allowed" Label="Allowed for accounts" @bind-Value="_allowedActions" Editing="_isEditing" />
            <AuditActionRow IdPrefix="platform-system" Label="Logged for system context" @bind-Value="_systemContextActions" Editing="_isEditing" />
            <AuditActionRow IdPrefix="platform-accountless" Label="Logged outside any account" @bind-Value="_accountlessActions" Editing="_isEditing" />
        </AuditActionMatrix>
        <ul class="settings-notes">
            <li>Allowed for accounts is the most each account can choose to log for its own members.</li>
            <li>The maximum retention also covers entries outside any account, system context and deleted accounts.</li>
            <li>Lowering a limit leaves each account's own choice alone; raising it again brings that choice back.</li>
            <li>With auditing off, only deleting a user or an account is recorded. Existing entries stay until they age out, or until a purge on the audit page.</li>
        </ul>
    </div>
}
</PlatformSettingsFrame>

<ConfirmModal @ref="_confirmModal" Title="Save platform settings" ConfirmText="Save"
              Type="@(_changes.Any(c => c.Weakens) ? ConfirmModalType.Warning : ConfirmModalType.Primary)" OnConfirm="SaveAsync">
    <SettingChangeList Changes="_changes" />
</ConfirmModal>

@code {
    private IAuditService AuditService => ScopedServices.GetRequiredService<IAuditService>();
    private IAuthorizationProvider AuthorizationProvider => ScopedServices.GetRequiredService<IAuthorizationProvider>();

    private ConfirmModal _confirmModal = null!;
    private IReadOnlyList<SettingChange> _changes = [];
    private PlatformSettings? _settings;
    private bool _canUpdate;
    private bool _isEditing;
    private bool _auditEnabled;
    private int _maxRetentionDays;
    private AuditActions _allowedActions;
    private AuditActions _systemContextActions;
    private AuditActions _accountlessActions;

    protected override async Task LoadCoreAsync()
    {
        var result = await AuditService.GetPlatformSettingsAsync();
        if (result.ResultCode != RetrieveResultCode.Success || result.Settings is null)
        {
            _loadFailed = true;
            _message = "You don't have access to the platform settings.";
            _messageType = AlertType.Warning;
            return;
        }

        _settings = result.Settings;
        _canUpdate = await AuthorizationProvider.IsAuthorizedAsync(
            AuthAction.Update,
            PlatformSettings.RESOURCE_TYPE
        );
        Reset();
    }

    private void Reset()
    {
        _auditEnabled = _settings!.AuditEnabled;
        _maxRetentionDays = _settings.AuditMaxRetentionDays;
        _allowedActions = _settings.AuditAllowedActions;
        _systemContextActions = _settings.SystemContextActions;
        _accountlessActions = _settings.AccountlessActions;
    }

    private void CancelEdit()
    {
        Reset();
        _isEditing = false;
    }

    private PlatformSettings WithEdits() =>
        new(_auditEnabled, _maxRetentionDays, _allowedActions, _systemContextActions, _accountlessActions);

    private async Task RequestSave()
    {
        _changes = _settings!.ChangesTo(WithEdits());
        if (_changes.Count == 0)
        {
            await SaveAsync();
            return;
        }

        _confirmModal.Show();
    }

    private async Task SaveAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await AuditService.UpdatePlatformSettingsAsync(WithEdits());
            SetResultMessage(result.ResultCode == ModifyResultCode.Success, "Platform settings saved.", result.Message);
            if (result.ResultCode == ModifyResultCode.Success)
            {
                _isEditing = false;
                _settings = (await AuditService.GetPlatformSettingsAsync()).Settings ?? _settings;
                Reset();
            }
        });
    }
}
