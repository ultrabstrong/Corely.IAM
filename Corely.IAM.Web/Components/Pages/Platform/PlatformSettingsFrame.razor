<div class="management-header">
    <h1><i class="bi bi-sliders me-2"></i>Platform Settings</h1>
    <a href="@AppRoutes.Dashboard" class="btn btn-outline-secondary" title="Back to dashboard"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
</div>

<div class="row g-4">
    <nav class="col-md-3" aria-label="Platform settings">
        <div class="list-group">
            <NavLink class="list-group-item list-group-item-action" href="@AppRoutes.PlatformAuditSettings" Match="NavLinkMatch.All">
                <i class="bi bi-journal-text me-2"></i>Audit
            </NavLink>
            <NavLink class="list-group-item list-group-item-action" href="@AppRoutes.PlatformSecuritySettings" Match="NavLinkMatch.All">
                <i class="bi bi-shield-lock me-2"></i>Security
            </NavLink>
        </div>
    </nav>
    <div class="col-md-9">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
