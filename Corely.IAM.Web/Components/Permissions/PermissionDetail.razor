@inherits EntityDetailPageBase
@inject IIamWebLinks Links

<div class="management-header">
    <h1><i class="bi bi-patch-check me-2"></i>Permission <span class="resource-label">Detail</span></h1>
    <a href="@Links.Permissions(CurrentAccountId)" class="btn btn-outline-secondary">Back to Permissions</a>
</div>

<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (_loading && _permission == null)
{
    <LoadingSpinner />
}
else if (_permission == null)
{
    <div class="alert alert-warning">Permission not found.</div>
}
else
{
    <div class="detail-section">

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Details
                @if (!_isEditing)
                {
                    <div class="d-flex gap-2">
                        <PermissionView Action="AuthAction.Update" Resource="@Permission.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                            <button class="btn btn-outline-primary btn-sm" @onclick="StartEdit">Edit</button>
                        </PermissionView>
                        @if (!_permission.IsSystemDefined)
                        {
                            <PermissionView Action="AuthAction.Delete" Resource="@Permission.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                                <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDelete" disabled="@_loading">Delete</button>
                            </PermissionView>
                        }
                    </div>
                }
                else if (_isEditing)
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_loading">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                    </div>
                }
            </div>
            @if (_isEditing)
            {
                <div class="props-grid mb-3">
                    <span class="prop-label">Name</span>
                    <div class="prop-value"><input type="text" class="form-control form-control-sm" @bind="_editDescription" placeholder="@_permission.DisplayName" /></div>
                </div>
            }
            <div class="props-grid">
                <span class="prop-label">Name</span>
                <span class="prop-value cell-title">
                    @(_permission.Description ?? _permission.DisplayName)
                </span>
                <span class="prop-label">Resource Type</span>
                <span class="prop-value">
                    <span class="type-badge ms-0">@_permission.ResourceType</span>
                    @if (_permission.IsSystemDefined)
                    {
                        <span class="sys-badge">System</span>
                    }
                </span>
                <span class="prop-label">Resource ID</span>
                <span class="prop-value">@if (_permission.ResourceId == Guid.Empty) { <text>all</text> } else { <CopyableId Value="_permission.ResourceId" /> }</span>
                <span class="prop-label">CRUDX</span>
                <span class="prop-value">
                    <span class="d-flex gap-2">
                        <span class="permission-badge @(_permission.Create ? "active" : "inactive")">C</span>
                        <span class="permission-badge @(_permission.Read ? "active" : "inactive")">R</span>
                        <span class="permission-badge @(_permission.Update ? "active" : "inactive")">U</span>
                        <span class="permission-badge @(_permission.Delete ? "active" : "inactive")">D</span>
                        <span class="permission-badge @(_permission.Execute ? "active" : "inactive")">X</span>
                    </span>
                </span>
            </div>
        </div>

        @if (_showRoles)
        {
            <div class="section-divider mb-4">
                <div class="section-divider-label">
                    Roles
                    <PermissionView Action="AuthAction.Update" Resource="@Role.RESOURCE_TYPE">
                        @if (_canGrantPermission)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => _rolePickerModal.ShowAsync()" disabled="@_loading">Add to Roles</button>
                        }
                    </PermissionView>
                </div>
                <table class="table table-striped table-hover table-cards mb-0">
                    <thead class="list-head"><tr><th>Name</th><th class="table-actions">Actions</th></tr></thead>
                    <tbody>
                        @if (_permission.Roles == null || _permission.Roles.Count == 0)
                        {
                            <tr><td colspan="2" class="text-muted text-center">No roles hold this permission</td></tr>
                        }
                        else
                        {
                            @foreach (var role in PagedRoles)
                            {
                                <tr>
                                    <td class="cell-title">
                                        @role.Name
                                        <br /><CopyableId Value="role.Id" />
                                        @if (role.IsSystemDefined)
                                        {
                                            <div class="title-badges">
                                                <span class="sys-badge">System</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="table-actions cell-actions">
                                        <div class="row-actions">
                                            <a href="@Links.Role(CurrentAccountId, role.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                            @if (!(_permission.IsSystemDefined && role.IsSystemDefined && role.Name == Role.OWNER_ROLE_NAME))
                                            {
                                                <PermissionView Action="AuthAction.Update" Resource="@Role.RESOURCE_TYPE" ResourceIds="new[] { role.Id }">
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRemoveRole(role.Id, role.Name)" title="Remove"><i class="bi bi-trash"></i></button>
                                                </PermissionView>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <Pagination Skip="_rolesSkip" Take="@RelationPageSize" TotalCount="@RolesTotalCount"
                            OnPageChanged="newSkip => { _rolesSkip = newSkip; StateHasChanged(); }" />
            </div>
        }

        <EffectivePermissionsPanel AccountId="CurrentAccountId" Permissions="_effectivePermissions" UseCard="false" />

    </div>
}

<EntityPickerModal @ref="_rolePickerModal"
                   Title="Add Permission to Roles"
                   SearchPlaceholder="Search roles..."
                   FetchItemsAsync="FetchAvailableRolesAsync"
                   ExcludeIds="_hiddenRoleIds"
                   OnConfirm="AddToRolesAsync" />

<ConfirmModal @ref="_confirmModal" Title="Delete Permission" ConfirmText="Delete" OnConfirm="DeleteAsync" />
<ConfirmModal @ref="_removeRoleModal" Title="Remove from Role" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveRoleAsync" />

@code {
    private IRetrievalService RetrievalService => ScopedServices.GetRequiredService<IRetrievalService>();
    private IDeregistrationService DeregistrationService => ScopedServices.GetRequiredService<IDeregistrationService>();
    private IModificationService ModificationService => ScopedServices.GetRequiredService<IModificationService>();
    private IRegistrationService RegistrationService => ScopedServices.GetRequiredService<IRegistrationService>();
    private IAuthorizationProvider AuthorizationProvider => ScopedServices.GetRequiredService<IAuthorizationProvider>();

    private Permission? _permission;
    private List<EffectivePermission>? _effectivePermissions;
    private EntityPickerModal _rolePickerModal = null!;
    private ConfirmModal _confirmModal = null!;
    private ConfirmModal _removeRoleModal = null!;
    private HashSet<Guid> _hiddenRoleIds = [];
    private bool _showRoles;
    private bool _canGrantPermission;
    private bool _isEditing;
    private string? _editDescription;

    private int _rolesSkip;
    private const int RelationPageSize = 10;
    private List<ChildRef> PagedRoles => (_permission?.Roles ?? []).Skip(_rolesSkip).Take(RelationPageSize).ToList();
    private int RolesTotalCount => _permission?.Roles?.Count ?? 0;

    protected override async Task LoadCoreAsync()
    {
        var result = await RetrievalService.GetPermissionAsync(Id, hydrate: true);
        if (result.ResultCode == RetrieveResultCode.Success && result.Item != null)
        {
            _permission = result.Item;
            _hiddenRoleIds = (_permission.Roles ?? []).Select(r => r.Id).ToHashSet();
            _showRoles = await AuthorizationProvider.IsAuthorizedAsync(AuthAction.Read, Role.RESOURCE_TYPE);
            _canGrantPermission = await AuthorizationProvider.CanGrantPermissionsAsync([Id]);
            _effectivePermissions = result.EffectivePermissions;
        }
    }

    private async Task<(List<PickerItem>, int)> FetchAvailableRolesAsync(int skip, int take)
    {
        var result = await RetrievalService.ListRolesAsync(new ListRolesRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode != RetrieveResultCode.Success || result.Data == null)
            return ([], 0);

        var changeable = await AuthorizationProvider.GetAuthorizedResourceIdsAsync(AuthAction.Update, Role.RESOURCE_TYPE);
        if (changeable != null)
            _hiddenRoleIds.UnionWith(result.Data.Items.Select(r => r.Id).Where(id => !changeable.Contains(id)));
        return ([.. result.Data.Items.Select(r => new PickerItem(r.Id, r.Name, r.Description))], result.Data.TotalCount);
    }

    private async Task AddToRolesAsync(List<Guid> roleIds)
    {
        await ExecuteSafeAsync(async () =>
        {
            var added = 0;
            string? failure = null;
            foreach (var roleId in roleIds)
            {
                var result = await RegistrationService.RegisterPermissionsWithRoleAsync(new RegisterPermissionsWithRoleRequest([Id], roleId, CurrentAccountId));
                if (result.ResultCode != AssignPermissionsToRoleResultCode.Success)
                {
                    failure = result.Message;
                    break;
                }
                added++;
            }
            SetResultMessage(failure == null, $"Added to {added} role(s).", $"Added to {added} of {roleIds.Count} role(s). {failure}");
            await ReloadAsync();
        });
    }

    private void ConfirmRemoveRole(Guid roleId, string name) => ShowConfirmation(_removeRoleModal, roleId, $"Remove this permission from role '{name}'?");

    private async Task RemoveRoleAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterPermissionsFromRoleAsync(new DeregisterPermissionsFromRoleRequest([Id], _confirmItemId, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterPermissionsFromRoleResultCode.Success, "Removed from role.", result.Message);
            await ReloadAsync();
        });
    }

    private void StartEdit()
    {
        _editDescription = _permission?.Description;
        _isEditing = true;
    }

    private void CancelEdit() => _isEditing = false;

    private async Task SaveAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await ModificationService.ModifyPermissionAsync(new UpdatePermissionRequest(Id, CurrentAccountId, _editDescription));
            SetResultMessage(result.ResultCode == ModifyResultCode.Success, "Permission updated.", result.Message);
            if (result.ResultCode == ModifyResultCode.Success)
            {
                _isEditing = false;
                await ReloadAsync();
            }
        });
    }

    private void ConfirmDelete()
    {
        if (_loading) return;
        _confirmModal.Show();
    }

    private async Task DeleteAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterPermissionAsync(new DeregisterPermissionRequest(Id, CurrentAccountId));
            if (result.ResultCode == DeregisterPermissionResultCode.Success)
            {
                NavigationManager.NavigateTo(Links.Permissions(CurrentAccountId));
                return;
            }
            SetResultMessage(false, string.Empty, result.Message);
        });
    }
}
