@inherits EntityPageBase

<PlatformSettingsFrame>
<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (_settings is null)
{
    @if (!_loadFailed)
    {
        <LoadingSpinner />
    }
}
else
{
    <div class="section-divider mb-4">
        <div class="section-divider-label">
            @PASSWORDS
            @EditButton(PASSWORDS)
        </div>
        <div class="settings-grid mb-3">
            <NumberSetting Label="Minimum length" @bind-Value="_passwordMinimumLength" Editing="IsEditing(PASSWORDS)"
                           Min="SecurityPolicy.PASSWORD_MINIMUM_LENGTH_MIN" Max="SecurityPolicy.PASSWORD_MINIMUM_LENGTH_MAX"
                           Hint="@($"{SecurityPolicy.PASSWORD_MINIMUM_LENGTH_RECOMMENDED} or more is recommended")" />
            <NumberSetting Label="Maximum length" @bind-Value="_passwordMaximumLength" Editing="IsEditing(PASSWORDS)"
                           Min="SecurityPolicy.PASSWORD_MAXIMUM_LENGTH_MIN" Max="SecurityPolicy.PASSWORD_MAXIMUM_LENGTH_MAX" />
            <span class="prop-label">Must contain</span>
            <div class="setting-wide toggle-list">
                <ToggleSetting Id="requireUppercase" Label="An uppercase letter" @bind-Value="_requireUppercase" Editing="IsEditing(PASSWORDS)" />
                <ToggleSetting Id="requireLowercase" Label="A lowercase letter" @bind-Value="_requireLowercase" Editing="IsEditing(PASSWORDS)" />
                <ToggleSetting Id="requireDigit" Label="A digit" @bind-Value="_requireDigit" Editing="IsEditing(PASSWORDS)" />
                <ToggleSetting Id="requireNonAlphanumeric" Label="A symbol" @bind-Value="_requireNonAlphanumeric" Editing="IsEditing(PASSWORDS)" />
            </div>
        </div>
        <ul class="settings-notes">
            <li>A stricter rule applies the next time a password is set. Saved passwords are not checked against it.</li>
        </ul>
    </div>

    <div class="section-divider mb-4">
        <div class="section-divider-label">
            @SIGN_IN
            @EditButton(SIGN_IN)
        </div>
        <div class="settings-grid mb-3">
            <NumberSetting Label="Failed sign ins before lockout" @bind-Value="_maxLoginAttempts" Editing="IsEditing(SIGN_IN)"
                           Min="SecurityPolicy.MAX_LOGIN_ATTEMPTS_MIN" Max="SecurityPolicy.MAX_LOGIN_ATTEMPTS_MAX" />
            <NumberSetting Label="Lockout length (seconds)" @bind-Value="_lockoutCooldownSeconds" Editing="IsEditing(SIGN_IN)"
                           Min="SecurityPolicy.LOCKOUT_COOLDOWN_SECONDS_MIN" Max="SecurityPolicy.LOCKOUT_COOLDOWN_SECONDS_MAX" />
            <NumberSetting Label="Sign in token lifetime (seconds)" @bind-Value="_authTokenTtlSeconds" Editing="IsEditing(SIGN_IN)"
                           Min="SecurityPolicy.AUTH_TOKEN_TTL_SECONDS_MIN" Max="SecurityPolicy.AUTH_TOKEN_TTL_SECONDS_MAX"
                           Hint="No longer than the session lifetime or the idle timeout" />
            <NumberSetting Label="Session lifetime (seconds)" @bind-Value="_authSessionTtlSeconds" Editing="IsEditing(SIGN_IN)"
                           Min="SecurityPolicy.AUTH_SESSION_TTL_SECONDS_MIN" Max="SecurityPolicy.AUTH_SESSION_TTL_SECONDS_MAX" />
            <NumberSetting Label="Idle timeout (seconds)" @bind-Value="_authSessionIdleTimeoutSeconds" Editing="IsEditing(SIGN_IN)"
                           Min="SecurityPolicy.AUTH_SESSION_IDLE_TIMEOUT_SECONDS_MIN" Max="SecurityPolicy.AUTH_SESSION_IDLE_TIMEOUT_SECONDS_MAX" />
            <NumberSetting Label="Refresh reuse grace (seconds)" @bind-Value="_refreshReuseGraceSeconds" Editing="IsEditing(SIGN_IN)"
                           Min="SecurityPolicy.REFRESH_REUSE_GRACE_SECONDS_MIN" Max="SecurityPolicy.REFRESH_REUSE_GRACE_SECONDS_MAX" />
        </div>
        <ul class="settings-notes">
            <li>A session ends at its lifetime, or sooner when it goes unused for the idle timeout.</li>
            <li>A refresh token used again after it was replaced ends its session, unless the reuse falls within the grace, as when two requests renew at once.</li>
        </ul>
    </div>

    <div class="section-divider mb-4">
        <div class="section-divider-label">
            @TWO_FACTOR
            @EditButton(TWO_FACTOR)
        </div>
        <div class="settings-grid mb-3">
            <NumberSetting Label="Code prompt timeout (seconds)" @bind-Value="_mfaChallengeTimeoutSeconds" Editing="IsEditing(TWO_FACTOR)"
                           Min="SecurityPolicy.MFA_CHALLENGE_TIMEOUT_SECONDS_MIN" Max="SecurityPolicy.MFA_CHALLENGE_TIMEOUT_SECONDS_MAX" />
            <NumberSetting Label="Recovery codes per user" @bind-Value="_totpRecoveryCodeCount" Editing="IsEditing(TWO_FACTOR)"
                           Min="SecurityPolicy.TOTP_RECOVERY_CODE_COUNT_MIN" Max="SecurityPolicy.TOTP_RECOVERY_CODE_COUNT_MAX" />
        </div>
    </div>

    <div class="section-divider mb-4">
        <div class="section-divider-label">
            @API_KEYS
            @EditButton(API_KEYS)
        </div>
        <div class="settings-grid mb-3">
            <span class="prop-label">API keys</span>
            <div class="setting-wide toggle-list">
                <ToggleSetting Id="apiKeysEnabled" Label="Accounts can create and use API keys" @bind-Value="_apiKeysEnabled" Editing="IsEditing(API_KEYS)" />
            </div>
            @if (_apiKeysEnabled)
            {
                <span class="prop-label">Platform account</span>
                <div class="setting-wide toggle-list">
                    <ToggleSetting Id="platformAccountApiKeysEnabled" Label="The platform account can hold API keys" @bind-Value="_platformAccountApiKeysEnabled" Editing="IsEditing(API_KEYS)" />
                </div>
                <NumberSetting Label="Longest secret lifetime (days)" @bind-Value="_apiKeyMaxLifetimeDays" Editing="IsEditing(API_KEYS)"
                               Min="SecurityPolicy.API_KEY_MAX_LIFETIME_DAYS_MIN" Max="SecurityPolicy.API_KEY_MAX_LIFETIME_DAYS_MAX" />
                <span class="prop-label setting-full">Resource types</span>
                <div class="setting-full">
                    <ResourceTypePicker Types="_resourceTypes" IdPrefix="apiKeyType" Multiple="true" Cards="true" ReadOnly="!IsEditing(API_KEYS)"
                                        Selected="_apiKeyResourceTypes" SelectedChanged="types => _apiKeyResourceTypes = new(types, StringComparer.OrdinalIgnoreCase)" />
                </div>
            }
        </div>
        <ul class="settings-notes">
            <li>A host takes API keys through Corely.IAM.Web's token endpoints (<code>MapIAMTokenEndpoints</code>) or through its own API.</li>
            <li>An API key uses only its permissions on the resource types switched on here, whatever its roles grant.</li>
        </ul>
    </div>
}
</PlatformSettingsFrame>

<ConfirmModal @ref="_confirmModal" Title="@($"{_pendingSection} settings")" ConfirmText="Save"
              Type="@(_changes.Any(c => c.Weakens) ? ConfirmModalType.Warning : ConfirmModalType.Primary)" OnConfirm="() => SaveAsync(_pendingSection)">
    <SettingChangeList Changes="_changes" />
</ConfirmModal>

@code {
    private IPlatformService PlatformService => ScopedServices.GetRequiredService<IPlatformService>();
    private IAuthorizationProvider AuthorizationProvider => ScopedServices.GetRequiredService<IAuthorizationProvider>();

    private const string PASSWORDS = "Passwords";
    private const string SIGN_IN = "Sign in";
    private const string TWO_FACTOR = "Two factor";
    private const string API_KEYS = "API keys";

    private ConfirmModal _confirmModal = null!;
    private IReadOnlyList<SettingChange> _changes = [];
    private string _pendingSection = PASSWORDS;
    private SecurityPolicy? _settings;
    private bool _canUpdate;
    private readonly HashSet<string> _editingSections = [];
    private int _passwordMinimumLength;
    private int _passwordMaximumLength;
    private bool _requireUppercase;
    private bool _requireLowercase;
    private bool _requireDigit;
    private bool _requireNonAlphanumeric;
    private int _maxLoginAttempts;
    private int _lockoutCooldownSeconds;
    private int _authTokenTtlSeconds;
    private int _authSessionTtlSeconds;
    private int _authSessionIdleTimeoutSeconds;
    private int _refreshReuseGraceSeconds;
    private int _mfaChallengeTimeoutSeconds;
    private int _totpRecoveryCodeCount;
    private bool _apiKeysEnabled;
    private bool _platformAccountApiKeysEnabled;
    private int _apiKeyMaxLifetimeDays;
    private HashSet<string> _apiKeyResourceTypes = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<ResourceTypeInfo> _resourceTypes = [];

    protected override async Task LoadCoreAsync()
    {
        var result = await PlatformService.GetSecuritySettingsAsync();
        if (result.ResultCode != RetrieveResultCode.Success || result.Settings is null)
        {
            _loadFailed = true;
            _message = "You don't have access to the platform settings.";
            _messageType = AlertType.Warning;
            return;
        }

        _settings = result.Settings;
        _canUpdate = await AuthorizationProvider.IsAuthorizedAsync(
            AuthAction.Update,
            SecurityPolicy.RESOURCE_TYPE
        );
        _resourceTypes = [.. ScopedServices.GetRequiredService<IResourceTypeRegistry>().GetAll()];
        Reset(PASSWORDS);
        Reset(SIGN_IN);
        Reset(TWO_FACTOR);
        Reset(API_KEYS);
    }

    private void Reset(string section)
    {
        switch (section)
        {
            case PASSWORDS:
                _passwordMinimumLength = _settings!.PasswordMinimumLength;
                _passwordMaximumLength = _settings.PasswordMaximumLength;
                _requireUppercase = _settings.RequireUppercase;
                _requireLowercase = _settings.RequireLowercase;
                _requireDigit = _settings.RequireDigit;
                _requireNonAlphanumeric = _settings.RequireNonAlphanumeric;
                break;
            case SIGN_IN:
                _maxLoginAttempts = _settings!.MaxLoginAttempts;
                _lockoutCooldownSeconds = _settings.LockoutCooldownSeconds;
                _authTokenTtlSeconds = _settings.AuthTokenTtlSeconds;
                _authSessionTtlSeconds = _settings.AuthSessionTtlSeconds;
                _authSessionIdleTimeoutSeconds = _settings.AuthSessionIdleTimeoutSeconds;
                _refreshReuseGraceSeconds = _settings.RefreshReuseGraceSeconds;
                break;
            case TWO_FACTOR:
                _mfaChallengeTimeoutSeconds = _settings!.MfaChallengeTimeoutSeconds;
                _totpRecoveryCodeCount = _settings.TotpRecoveryCodeCount;
                break;
            case API_KEYS:
                _apiKeysEnabled = _settings!.ApiKeysEnabled;
                _platformAccountApiKeysEnabled = _settings.PlatformAccountApiKeysEnabled;
                _apiKeyMaxLifetimeDays = _settings.ApiKeyMaxLifetimeDays;
                _apiKeyResourceTypes = new(_settings.ApiKeyResourceTypes.Types, StringComparer.OrdinalIgnoreCase);
                break;
        }
    }

    private SecurityPolicy WithEdits(string section) =>
        section switch
        {
            PASSWORDS => _settings! with
            {
                PasswordMinimumLength = _passwordMinimumLength,
                PasswordMaximumLength = _passwordMaximumLength,
                RequireUppercase = _requireUppercase,
                RequireLowercase = _requireLowercase,
                RequireDigit = _requireDigit,
                RequireNonAlphanumeric = _requireNonAlphanumeric,
            },
            SIGN_IN => _settings! with
            {
                MaxLoginAttempts = _maxLoginAttempts,
                LockoutCooldownSeconds = _lockoutCooldownSeconds,
                AuthTokenTtlSeconds = _authTokenTtlSeconds,
                AuthSessionTtlSeconds = _authSessionTtlSeconds,
                AuthSessionIdleTimeoutSeconds = _authSessionIdleTimeoutSeconds,
                RefreshReuseGraceSeconds = _refreshReuseGraceSeconds,
            },
            API_KEYS => _settings! with
            {
                ApiKeysEnabled = _apiKeysEnabled,
                PlatformAccountApiKeysEnabled = _platformAccountApiKeysEnabled,
                ApiKeyMaxLifetimeDays = _apiKeyMaxLifetimeDays,
                ApiKeyResourceTypes = new ResourceTypeSet(_apiKeyResourceTypes),
            },
            _ => _settings! with
            {
                MfaChallengeTimeoutSeconds = _mfaChallengeTimeoutSeconds,
                TotpRecoveryCodeCount = _totpRecoveryCodeCount,
            },
        };

    private bool IsEditing(string section) => _editingSections.Contains(section);

    private RenderFragment EditButton(string section) =>
        @<text>
            @if (!IsEditing(section) && _canUpdate)
            {
                <button class="btn btn-outline-primary btn-sm" @onclick="() => _editingSections.Add(section)">Edit</button>
            }
            else if (IsEditing(section))
            {
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="() => RequestSave(section)" disabled="@_loading">Save</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => CancelEdit(section)" disabled="@_loading">Cancel</button>
                </div>
            }
        </text>;

    private void CancelEdit(string section)
    {
        Reset(section);
        _editingSections.Remove(section);
    }

    private async Task RequestSave(string section)
    {
        _changes = _settings!.ChangesTo(WithEdits(section));
        if (_changes.Count == 0)
        {
            await SaveAsync(section);
            return;
        }

        _pendingSection = section;
        _confirmModal.Show();
    }

    private async Task SaveAsync(string section)
    {
        await ExecuteSafeAsync(async () =>
        {
            var settings = WithEdits(section);
            var result = await PlatformService.UpdateSecuritySettingsAsync(settings);
            SetResultMessage(result.ResultCode == ModifyResultCode.Success, $"{section} settings saved.", result.Message);
            if (result.ResultCode == ModifyResultCode.Success)
            {
                _settings = settings;
                CancelEdit(section);
            }
        });
    }
}
