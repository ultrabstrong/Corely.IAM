@inherits OwningComponentBase
@inject IIamWebLinks Links
@using Corely.IAM.Web.Configuration
@inject IOptions<IAMWebOptions> IamWebOptions

<div class="management-header">
    <h1><i class="bi bi-sliders me-2"></i>Platform Settings</h1>
    <a href="@Links.Dashboard()" class="btn btn-outline-secondary" title="Back to dashboard"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
</div>

<div class="row g-4">
    <nav class="col-md-3" aria-label="Platform settings">
        <div class="list-group">
            @foreach (var settingsPage in _pages)
            {
                <NavLink class="list-group-item list-group-item-action" href="@settingsPage.Path" Match="NavLinkMatch.All">
                    <i class="bi @settingsPage.Icon me-2"></i>@settingsPage.Title
                </NavLink>
            }
        </div>
    </nav>
    <div class="col-md-9">
        @ChildContent
    </div>
</div>

@code {
    private IBlazorUserContextAccessor BlazorUserContextAccessor => ScopedServices.GetRequiredService<IBlazorUserContextAccessor>();
    private IAuthorizationProvider AuthorizationProvider => ScopedServices.GetRequiredService<IAuthorizationProvider>();

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    private IReadOnlyList<PlatformSettingsPage> _pages = [];

    protected override async Task OnInitializedAsync()
    {
        if (await BlazorUserContextAccessor.GetUserContextAsync() == null)
            return;
        _pages = await IamWebOptions.Value.ReadablePlatformSettingsPagesAsync(AuthorizationProvider);
    }
}
