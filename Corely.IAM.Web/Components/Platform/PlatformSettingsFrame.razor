@inherits OperationComponentBase
@inject IIamWebLinks Links
@inject NavigationManager Navigation
@using Corely.IAM.Web.Configuration
@inject IOptions<IAMWebOptions> IamWebOptions

<div class="management-header">
    <h1><i class="bi bi-sliders me-2"></i>Platform Settings</h1>
    <a href="@Links.Dashboard()" class="btn btn-outline-secondary" title="Back to dashboard"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
</div>

<div class="settings-frame">
    <div class="settings-frame-picker">
        <label for="settings-frame-select" class="visually-hidden">Platform settings page</label>
        <select id="settings-frame-select" class="form-select" value="@CurrentPath" @onchange="OnPick">
            @foreach (var settingsPage in _pages)
            {
                <option value="@settingsPage.Path">@settingsPage.Title</option>
            }
        </select>
    </div>
    <nav class="settings-frame-nav" aria-label="Platform settings">
        <div class="list-group">
            @foreach (var settingsPage in _pages)
            {
                <NavLink class="list-group-item list-group-item-action" href="@settingsPage.Path" Match="NavLinkMatch.All">
                    <i class="bi @settingsPage.Icon me-2"></i>@settingsPage.Title
                </NavLink>
            }
        </div>
    </nav>
    <div class="settings-frame-content">
        @ChildContent
    </div>
</div>

@code {

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    private IReadOnlyList<PlatformSettingsPage> _pages = [];

    private string CurrentPath =>
        _pages.FirstOrDefault(p => Navigation.Uri.TrimEnd('/').EndsWith(p.Path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase))?.Path
        ?? string.Empty;

    protected override async Task OnInitializedAsync() =>
        _pages = await InOperationAsync(services =>
            IamWebOptions.Value.ReadablePlatformSettingsPagesAsync(services.GetRequiredService<IAuthorizationProvider>())
        ) ?? _pages;

    private void OnPick(ChangeEventArgs e)
    {
        if (e.Value is string path && !string.IsNullOrEmpty(path))
            Navigation.NavigateTo(path);
    }
}
