@inherits OperationComponentBase
@using Corely.IAM.Web.Configuration
@inject NavigationManager Navigation
@inject IOptions<IAMWebOptions> IamWebOptions

@if (_noneReadable)
{
    <div class="alert alert-warning">You do not have access to any platform settings.</div>
}

@code {

    private bool _noneReadable;

    protected override async Task OnInitializedAsync()
    {
        var pages = await InOperationAsync(services =>
            IamWebOptions.Value.ReadablePlatformSettingsPagesAsync(services.GetRequiredService<IAuthorizationProvider>())
        );
        if (pages is null)
            return;
        if (pages.Count == 0)
        {
            _noneReadable = true;
            return;
        }
        Navigation.NavigateTo(pages[0].Path, replace: true);
    }
}
