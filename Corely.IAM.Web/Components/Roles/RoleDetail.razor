@inherits EntityDetailPageBase
@inject IIamWebLinks Links
@inject Corely.IAM.Permissions.Providers.IResourceTypeRegistry ResourceTypeRegistry

<div class="management-header">
    <h1><i class="bi bi-shield me-2"></i>@(_role?.Name ?? "Role") <span class="resource-label">Role</span></h1>
    <a href="@Links.Roles(CurrentAccountId)" class="btn btn-outline-secondary">Back to Roles</a>
</div>

<Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

@if (_loading && _role == null)
{
    <LoadingSpinner />
}
else if (_role == null)
{
    <div class="alert alert-warning">Role not found.</div>
}
else
{
    <div class="detail-section">

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Details
                @if (!_isEditing && !_role.IsSystemDefined)
                {
                    <div class="d-flex gap-2">
                        <PermissionView Action="AuthAction.Update" Resource="@Role.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                            <button class="btn btn-outline-primary btn-sm" @onclick="StartEdit">Edit</button>
                        </PermissionView>
                        <PermissionView Action="AuthAction.Delete" Resource="@Role.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                            <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDelete" disabled="@_loading">Delete</button>
                        </PermissionView>
                    </div>
                }
                else if (_isEditing)
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="SavePropertiesAsync" disabled="@_loading">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                    </div>
                }
            </div>
            @if (_isEditing)
            {
                <div class="props-grid mb-3">
                    <span class="prop-label">Name</span>
                    <div class="prop-value"><input type="text" class="form-control form-control-sm" @bind="_editName" /></div>
                    <span class="prop-label">Description</span>
                    <div class="prop-value"><input type="text" class="form-control form-control-sm" @bind="_editDescription" placeholder="Optional" /></div>
                </div>
            }
            else
            {
                <div class="props-grid">
                    <span class="prop-label cell-hide">Name</span>
                    <span class="prop-value cell-title">
                        @_role.Name
                        @if (_role.IsSystemDefined)
                        {
                            <span class="sys-badge ms-2">System</span>
                        }
                    </span>
                    <span class="prop-label cell-hide">Description</span>
                    <span class="prop-value cell-sub @(_role.Description is null ? "cell-hide" : null)">@(_role.Description ?? "—")</span>
                </div>
            }
        </div>

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Permissions
                <PermissionView Action="AuthAction.Update" Resource="@Role.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                    <button class="btn btn-primary btn-sm" @onclick="() => _permissionPickerModal.ShowAsync()" disabled="@_loading">Add Permissions</button>
                </PermissionView>
            </div>
            <table class="table table-striped table-hover table-cards mb-0">
                <thead class="list-head"><tr><th>Name</th><th class="table-actions">Actions</th></tr></thead>
                <tbody>
                    @if (_role.Permissions == null || _role.Permissions.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted text-center">No permissions assigned</td></tr>
                    }
                    else
                    {
                        @foreach (var permission in PagedPermissions)
                        {
                            <tr>
                                <td class="cell-title">
                                    @permission.Name
                                    <br /><CopyableId Value="permission.Id" />
                                    @if (permission.IsSystemDefined)
                                    {
                                        <div class="title-badges">
                                            <span class="sys-badge">System</span>
                                        </div>
                                    }
                                </td>
                                <td class="table-actions cell-actions">
                                    <div class="row-actions">
                                        @if (!(permission.IsSystemDefined && _role.IsSystemDefined && _role.Name == Corely.IAM.Roles.Models.Role.OWNER_ROLE_NAME))
                                        {
                                            <PermissionView Action="AuthAction.Update" Resource="@Role.RESOURCE_TYPE" ResourceIds="new[] { Id }">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRemovePermission(permission.Id, permission.Name)" title="Remove"><i class="bi bi-trash"></i></button>
                                            </PermissionView>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <Pagination Skip="_permissionsSkip" Take="@RelationPageSize" TotalCount="@PermissionsTotalCount"
                        OnPageChanged="newSkip => { _permissionsSkip = newSkip; StateHasChanged(); }" />
        </div>

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Users
                <PermissionView Action="AuthAction.Update" Resource="@User.RESOURCE_TYPE">
                    @if (_canGrantRole)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => _userPickerModal.ShowAsync()" disabled="@_loading">Add Users</button>
                    }
                </PermissionView>
            </div>
            @HolderTable(_role.Users, "No users hold this role", User.RESOURCE_TYPE, id => Links.User(CurrentAccountId, id), ConfirmRemoveUser)
        </div>

        <div class="section-divider mb-4">
            <div class="section-divider-label">
                Groups
                <PermissionView Action="AuthAction.Update" Resource="@Group.RESOURCE_TYPE">
                    @if (_canGrantRole)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => _groupPickerModal.ShowAsync()" disabled="@_loading">Add Groups</button>
                    }
                </PermissionView>
            </div>
            @HolderTable(_role.Groups, "No groups hold this role", Group.RESOURCE_TYPE, id => Links.Group(CurrentAccountId, id), ConfirmRemoveGroup)
        </div>

        @if (_showApiKeys)
        {
            <div class="section-divider mb-4">
                <div class="section-divider-label">
                    API keys
                    <PermissionView Action="AuthAction.Update" Resource="@ApiKey.RESOURCE_TYPE">
                        @if (_canGrantRole)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => _apiKeyPickerModal.ShowAsync()" disabled="@_loading">Add API keys</button>
                        }
                    </PermissionView>
                </div>
                @HolderTable(_role.ApiKeys, "No API keys hold this role", ApiKey.RESOURCE_TYPE, id => Links.ApiKey(CurrentAccountId, id), ConfirmRemoveApiKey)
            </div>
        }

        <EffectivePermissionsPanel AccountId="CurrentAccountId" Permissions="_effectivePermissions" UseCard="false" />

    </div>
}

<EntityPickerModal @ref="_permissionPickerModal"
                   Title="Add Permissions to Role"
                   SearchPlaceholder="Search permissions..."
                   FetchItemsAsync="FetchAvailablePermissionsAsync"
                   ExcludeIds="_hiddenPermissionIds"
                   OnConfirm="AddPermissionsAsync" />

<EntityPickerModal @ref="_userPickerModal"
                   Title="Add Users to Role"
                   SearchPlaceholder="Search users..."
                   FetchItemsAsync="FetchAvailableUsersAsync"
                   ExcludeIds="_hiddenUserIds"
                   OnConfirm="AddUsersAsync" />

<EntityPickerModal @ref="_groupPickerModal"
                   Title="Add Groups to Role"
                   SearchPlaceholder="Search groups..."
                   FetchItemsAsync="FetchAvailableGroupsAsync"
                   ExcludeIds="_hiddenGroupIds"
                   OnConfirm="AddGroupsAsync" />

<EntityPickerModal @ref="_apiKeyPickerModal"
                   Title="Add API keys to Role"
                   SearchPlaceholder="Search API keys..."
                   FetchItemsAsync="FetchAvailableApiKeysAsync"
                   ExcludeIds="_hiddenApiKeyIds"
                   OnConfirm="AddApiKeysAsync" />

<ConfirmModal @ref="_removePermissionModal" Title="Remove Permission" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemovePermissionAsync" />
<ConfirmModal @ref="_removeUserModal" Title="Remove User" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveUserAsync" />
<ConfirmModal @ref="_removeGroupModal" Title="Remove Group" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveGroupAsync" />
<ConfirmModal @ref="_removeApiKeyModal" Title="Remove API key" Message="@_confirmMessage" ConfirmText="Remove" OnConfirm="RemoveApiKeyAsync" />
<ConfirmModal @ref="_deleteModal" Title="Delete Role" Message="@($"Permanently delete role '{_role?.Name}'? This cannot be undone.")" ConfirmText="Delete" OnConfirm="DeleteAsync" />

@code {
    private IRetrievalService RetrievalService => ScopedServices.GetRequiredService<IRetrievalService>();
    private IModificationService ModificationService => ScopedServices.GetRequiredService<IModificationService>();
    private IRegistrationService RegistrationService => ScopedServices.GetRequiredService<IRegistrationService>();
    private IDeregistrationService DeregistrationService => ScopedServices.GetRequiredService<IDeregistrationService>();
    private IAuthorizationProvider AuthorizationProvider => ScopedServices.GetRequiredService<IAuthorizationProvider>();

    private ISecurityPolicyProvider SecurityPolicyProvider => ScopedServices.GetRequiredService<ISecurityPolicyProvider>();

    private Role? _role;
    private bool _showApiKeys;
    private bool _canGrantRole;
    private string _editName = string.Empty;
    private string? _editDescription;
    private string _originalName = string.Empty;
    private string? _originalDescription;
    private bool _isEditing;
    private HashSet<Guid> _assignedPermissionIds = [];
    private HashSet<Guid> _hiddenPermissionIds = [];
    private HashSet<Guid> _hiddenUserIds = [];
    private HashSet<Guid> _hiddenGroupIds = [];
    private HashSet<Guid> _hiddenApiKeyIds = [];
    private List<EffectivePermission>? _effectivePermissions;
    private EntityPickerModal _permissionPickerModal = null!;
    private EntityPickerModal _userPickerModal = null!;
    private EntityPickerModal _groupPickerModal = null!;
    private EntityPickerModal _apiKeyPickerModal = null!;
    private ConfirmModal _removePermissionModal = null!;
    private ConfirmModal _removeUserModal = null!;
    private ConfirmModal _removeGroupModal = null!;
    private ConfirmModal _removeApiKeyModal = null!;
    private ConfirmModal _deleteModal = null!;

    private int _permissionsSkip;
    private const int RelationPageSize = 10;
    private List<ChildRef> PagedPermissions => (_role?.Permissions ?? []).Skip(_permissionsSkip).Take(RelationPageSize).ToList();
    private int PermissionsTotalCount => _role?.Permissions?.Count ?? 0;

    protected override async Task LoadCoreAsync()
    {
        var result = await RetrievalService.GetRoleAsync(Id, hydrate: true);
        if (result.ResultCode == RetrieveResultCode.Success && result.Item != null)
        {
            _role = result.Item;
            _editName = _role.Name;
            _editDescription = _role.Description;
            _assignedPermissionIds = (_role.Permissions ?? []).Select(p => p.Id).ToHashSet();
            _hiddenPermissionIds = [.. _assignedPermissionIds];
            _hiddenUserIds = (_role.Users ?? []).Select(u => u.Id).ToHashSet();
            _hiddenGroupIds = (_role.Groups ?? []).Select(g => g.Id).ToHashSet();
            _hiddenApiKeyIds = (_role.ApiKeys ?? []).Select(k => k.Id).ToHashSet();
            _canGrantRole = await AuthorizationProvider.CanGrantRolesAsync([Id]);
            _effectivePermissions = result.EffectivePermissions;
            _showApiKeys = (await SecurityPolicyProvider.GetPolicyAsync()).AllowsApiKeysIn(UserContext?.CurrentAccount?.IsPlatformAccount == true)
                && await AuthorizationProvider.IsAuthorizedAsync(AuthAction.Read, ApiKey.RESOURCE_TYPE);
        }
    }

    private void ConfirmDelete() => _deleteModal.Show();

    private async Task DeleteAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterRoleAsync(new DeregisterRoleRequest(Id, CurrentAccountId));
            if (result.ResultCode == DeregisterRoleResultCode.Success)
            {
                NavigationManager.NavigateTo(Links.Roles(CurrentAccountId));
                return;
            }
            SetResultMessage(false, string.Empty, result.Message);
        });
    }

    private void StartEdit()
    {
        _originalName = _editName;
        _originalDescription = _editDescription;
        _isEditing = true;
    }

    private void CancelEdit()
    {
        _editName = _originalName;
        _editDescription = _originalDescription;
        _isEditing = false;
    }

    private async Task<(List<PickerItem>, int)> FetchAvailablePermissionsAsync(int skip, int take)
    {
        var result = await RetrievalService.ListPermissionsAsync(new ListPermissionsRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode == RetrieveResultCode.Success && result.Data != null)
        {
            var grantable = await AuthorizationProvider.GetGrantablePermissionIdsAsync(result.Data.Items.Select(x => x.Id));
            _hiddenPermissionIds.UnionWith(result.Data.Items.Select(x => x.Id).Where(id => !grantable.Contains(id)));
            var items = result.Data.Items
                .Select(p => new PickerItem(
                    p.Id,
                    p.Description ?? p.DisplayName,
                    $"{p.ActionsText()} on {p.ScopeText()}",
                    ResourceTypeRegistry.Get(p.ResourceType)?.GroupedTitle ?? p.ResourceType,
                    TypeOrder.GetValueOrDefault(p.ResourceType, int.MaxValue)
                ))
                .ToList();
            return (items, result.Data.TotalCount);
        }
        return ([], 0);
    }

    private async Task SavePropertiesAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        await ExecuteSafeAsync(async () =>
        {
            var result = await ModificationService.ModifyRoleAsync(new UpdateRoleRequest(Id, CurrentAccountId, _editName, _editDescription));
            SetResultMessage(result.ResultCode == ModifyResultCode.Success, "Role updated.", result.Message);
            if (result.ResultCode == ModifyResultCode.Success)
            {
                _isEditing = false;
                await ReloadAsync();
            }
        });
    }

    private async Task AddPermissionsAsync(List<Guid> permissionIds)
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await RegistrationService.RegisterPermissionsWithRoleAsync(new RegisterPermissionsWithRoleRequest(permissionIds, Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == AssignPermissionsToRoleResultCode.Success, $"{permissionIds.Count} permission(s) added.", result.Message);
            await ReloadAsync();
        });
    }

    private void ConfirmRemovePermission(Guid permissionId, string name) => ShowConfirmation(_removePermissionModal, permissionId, $"Remove permission '{name}'?");

    private async Task RemovePermissionAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterPermissionsFromRoleAsync(new DeregisterPermissionsFromRoleRequest([_confirmItemId], Id, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterPermissionsFromRoleResultCode.Success, "Permission removed.", result.Message);
            await ReloadAsync();
        });
    }

    private async Task<(List<PickerItem>, int)> FetchAvailableUsersAsync(int skip, int take)
    {
        var result = await RetrievalService.ListUsersAsync(new ListUsersRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode != RetrieveResultCode.Success || result.Data == null)
            return ([], 0);

        await HideUnchangeableAsync(_hiddenUserIds, User.RESOURCE_TYPE, result.Data.Items.Select(u => u.Id));
        return ([.. result.Data.Items.Select(u => new PickerItem(u.Id, u.Username, u.Email))], result.Data.TotalCount);
    }

    private async Task<(List<PickerItem>, int)> FetchAvailableGroupsAsync(int skip, int take)
    {
        var result = await RetrievalService.ListGroupsAsync(new ListGroupsRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode != RetrieveResultCode.Success || result.Data == null)
            return ([], 0);

        await HideUnchangeableAsync(_hiddenGroupIds, Group.RESOURCE_TYPE, result.Data.Items.Select(g => g.Id));
        return ([.. result.Data.Items.Select(g => new PickerItem(g.Id, g.Name, g.Description))], result.Data.TotalCount);
    }

    private async Task<(List<PickerItem>, int)> FetchAvailableApiKeysAsync(int skip, int take)
    {
        var result = await RetrievalService.ListApiKeysAsync(new ListApiKeysRequest(CurrentAccountId, Skip: skip, Take: take));
        if (result.ResultCode != RetrieveResultCode.Success || result.Data == null)
            return ([], 0);

        await HideUnchangeableAsync(_hiddenApiKeyIds, ApiKey.RESOURCE_TYPE, result.Data.Items.Select(k => k.Id));
        return ([.. result.Data.Items.Select(k => new PickerItem(k.Id, k.Name, k.Description))], result.Data.TotalCount);
    }

    private async Task HideUnchangeableAsync(HashSet<Guid> hidden, string resourceType, IEnumerable<Guid> ids)
    {
        var changeable = await AuthorizationProvider.GetAuthorizedResourceIdsAsync(AuthAction.Update, resourceType);
        if (changeable != null)
            hidden.UnionWith(ids.Where(id => !changeable.Contains(id)));
    }

    private Task AddUsersAsync(List<Guid> userIds) =>
        AddHoldersAsync(userIds, "user(s)", async userId =>
        {
            var result = await RegistrationService.RegisterRolesWithUserAsync(new RegisterRolesWithUserRequest([Id], userId, CurrentAccountId));
            return result.ResultCode == AssignRolesToUserResultCode.Success ? null : result.Message;
        });

    private Task AddGroupsAsync(List<Guid> groupIds) =>
        AddHoldersAsync(groupIds, "group(s)", async groupId =>
        {
            var result = await RegistrationService.RegisterRolesWithGroupAsync(new RegisterRolesWithGroupRequest([Id], groupId, CurrentAccountId));
            return result.ResultCode == AssignRolesToGroupResultCode.Success ? null : result.Message;
        });

    private Task AddApiKeysAsync(List<Guid> apiKeyIds) =>
        AddHoldersAsync(apiKeyIds, "API key(s)", async apiKeyId =>
        {
            var result = await RegistrationService.RegisterRolesWithApiKeyAsync(new RegisterRolesWithApiKeyRequest([Id], apiKeyId, CurrentAccountId));
            return result.ResultCode == AssignRolesToApiKeyResultCode.Success ? null : result.Message;
        });

    private async Task AddHoldersAsync(List<Guid> holderIds, string noun, Func<Guid, Task<string?>> add)
    {
        await ExecuteSafeAsync(async () =>
        {
            var added = 0;
            string? failure = null;
            foreach (var holderId in holderIds)
            {
                failure = await add(holderId);
                if (failure != null)
                    break;
                added++;
            }
            SetResultMessage(failure == null, $"{added} {noun} added.", $"{added} of {holderIds.Count} {noun} added. {failure}");
            await ReloadAsync();
        });
    }

    private void ConfirmRemoveUser(Guid userId, string name) => ShowConfirmation(_removeUserModal, userId, $"Remove user '{name}' from this role?");

    private async Task RemoveUserAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterRolesFromUserAsync(new DeregisterRolesFromUserRequest([Id], _confirmItemId, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterRolesFromUserResultCode.Success, "User removed.", result.Message);
            await ReloadAsync();
        });
    }

    private void ConfirmRemoveGroup(Guid groupId, string name) => ShowConfirmation(_removeGroupModal, groupId, $"Remove group '{name}' from this role?");

    private async Task RemoveGroupAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterRolesFromGroupAsync(new DeregisterRolesFromGroupRequest([Id], _confirmItemId, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterRolesFromGroupResultCode.Success, "Group removed.", result.Message);
            await ReloadAsync();
        });
    }

    private void ConfirmRemoveApiKey(Guid apiKeyId, string name) => ShowConfirmation(_removeApiKeyModal, apiKeyId, $"Remove API key '{name}' from this role?");

    private async Task RemoveApiKeyAsync()
    {
        await ExecuteSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterRolesFromApiKeyAsync(new DeregisterRolesFromApiKeyRequest([Id], _confirmItemId, CurrentAccountId));
            SetResultMessage(result.ResultCode == DeregisterRolesFromApiKeyResultCode.Success, "API key removed.", result.Message);
            await ReloadAsync();
        });
    }

    private RenderFragment HolderTable(List<ChildRef>? holders, string empty, string resourceType, Func<Guid, string> link, Action<Guid, string> confirmRemove) =>
        @<table class="table table-striped table-hover table-cards mb-0">
            <thead class="list-head"><tr><th>Name</th><th class="table-actions">Actions</th></tr></thead>
            <tbody>
                @if (holders == null || holders.Count == 0)
                {
                    <tr><td colspan="2" class="text-muted text-center">@empty</td></tr>
                }
                else
                {
                    @foreach (var holder in holders)
                    {
                        <tr>
                            <td class="cell-title">@holder.Name<br /><CopyableId Value="holder.Id" /></td>
                            <td class="table-actions cell-actions">
                                <div class="row-actions">
                                    <a href="@link(holder.Id)" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                    <PermissionView Action="AuthAction.Update" Resource="@resourceType" ResourceIds="new[] { holder.Id }">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmRemove(holder.Id, holder.Name)" title="Remove"><i class="bi bi-trash"></i></button>
                                    </PermissionView>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>;

    private Dictionary<string, int> TypeOrder =>
        _typeOrder ??= ResourceTypeRegistry
            .GetAll()
            .Grouped()
            .SelectMany(g => g.Types)
            .Select((t, i) => (t.Name, i))
            .ToDictionary(x => x.Name, x => x.i, StringComparer.OrdinalIgnoreCase);

    private Dictionary<string, int>? _typeOrder;
}
