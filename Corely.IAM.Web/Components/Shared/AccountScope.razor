@inherits OperationComponentBase
@inject NavigationManager NavigationManager

@if (_matches)
{
    @ChildContent
}
else
{
    <LoadingSpinner />
}

@code {

    [Parameter, EditorRequired]
    public Guid AccountId { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _matches;
    private bool _leaving;

    protected override async Task OnParametersSetAsync()
    {
        if (_leaving)
            return;
        var userContext = await InOperationAsync(services =>
            services.GetRequiredService<IBlazorUserContextAccessor>().GetUserContextAsync()
        );
        if (_leaving)
            return;
        _matches = userContext?.CurrentAccount?.Id == AccountId;
        if (_matches)
            return;
        _leaving = true;
        if (!HasSession)
            NavigationManager.NavigateTo(NavigationManager.SignInUri(), forceLoad: true);
        // With a session but no user, the operation could not sign in and has already reloaded the page.
        else if (userContext?.User != null)
            NavigationManager.NavigateTo(NavigationManager.SwitchAccountUri(AccountId), forceLoad: true);
    }
}
