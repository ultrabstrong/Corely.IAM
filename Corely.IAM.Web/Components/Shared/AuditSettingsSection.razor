@inherits OwningComponentBase

<div class="section-divider mb-4">
    <div class="section-divider-label">
        Audit
        @if (_settings is not null && !_isEditing)
        {
            <PermissionView Action="AuthAction.Update" Resource="@AuditConstants.AUDIT_SETTINGS_RESOURCE_TYPE">
                <button class="btn btn-outline-primary btn-sm" @onclick="StartEdit" disabled="@_busy">Edit</button>
            </PermissionView>
        }
    </div>

    <Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />

    @if (_settings is null)
    {
        @if (_message is null)
        {
            <LoadingSpinner />
        }
    }
    else
    {
        <AuditActionMatrix>
            <AuditActionRow IdPrefix="audit-members" Label="Logged for account members" @bind-Value="_accountMemberActions" Allowed="_allowedActions" Editing="_isEditing" />
            <AuditActionRow IdPrefix="audit-platform" Label="Logged for platform members" @bind-Value="_platformMemberActions" Allowed="_allowedActions" Editing="_isEditing" />
        </AuditActionMatrix>
        <div class="settings-grid mt-3 mb-3">
            <NumberSetting Label="Keep entries for (days)"
                           Value="@(_isEditing ? _retentionDays : Math.Min(_retentionDays, _maxRetentionDays))"
                           ValueChanged="value => _retentionDays = value"
                           Editing="_isEditing" Min="0" Max="_maxRetentionDays"
                           Hint="@(_isEditing ? "The platform's maximum is the top of the range." : null)" />
        </div>
        @if (_isEditing)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_busy">Save</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit" disabled="@_busy">Cancel</button>
            </div>
        }
        <ul class="settings-notes">
            <li>An action left off is not recorded for that group in this account.</li>
            <li>Deleting a user and deleting an account are always recorded.</li>
        </ul>
    }
</div>

@code {
    private IAuditService AuditService => ScopedServices.GetRequiredService<IAuditService>();

    [Parameter, EditorRequired]
    public Guid AccountId { get; set; }

    private AccountAuditSettings? _settings;
    private AuditActions _accountMemberActions;
    private AuditActions _platformMemberActions;
    private AuditActions _allowedActions = AuditActions.All;
    private int _retentionDays;
    private int _maxRetentionDays;
    private bool _isEditing;
    private bool _busy;
    private string? _message;
    private AlertType _messageType = AlertType.Info;

    protected override async Task OnParametersSetAsync()
    {
        await ScopedServices.GetRequiredService<IBlazorUserContextAccessor>().GetUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await AuditService.GetAccountSettingsAsync(AccountId);
        if (result.ResultCode != RetrieveResultCode.Success || result.Settings is null)
        {
            _settings = null;
            _message = "The audit settings couldn't be loaded.";
            _messageType = AlertType.Warning;
            return;
        }

        _settings = result.Settings;
        _allowedActions = result.AllowedActions;
        _maxRetentionDays = result.MaxRetentionDays;
        Reset();
    }

    private void Reset()
    {
        _accountMemberActions = _settings!.AccountMemberActions;
        _platformMemberActions = _settings.PlatformMemberActions;
        _retentionDays = _settings.RetentionDays;
    }

    private void StartEdit() => _isEditing = true;

    private void CancelEdit()
    {
        Reset();
        _isEditing = false;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var result = await AuditService.UpdateAccountSettingsAsync(
                new UpdateAccountAuditSettingsRequest(
                    AccountId,
                    _accountMemberActions,
                    _platformMemberActions,
                    _retentionDays
                )
            );
            if (result.ResultCode == ModifyResultCode.Success)
            {
                _isEditing = false;
                _message = "Audit settings saved.";
                _messageType = AlertType.Success;
                await LoadAsync();
            }
            else
            {
                _message = result.Message;
                _messageType = AlertType.Danger;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
