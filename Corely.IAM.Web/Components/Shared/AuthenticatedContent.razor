@inherits OperationComponentBase

@if (_loaded)
{
    @ChildContent
}
else
{
    <LoadingSpinner />
}

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _loaded;

    // An empty operation proves the tab is signed in; when it is not, the operation has left the page.
    protected override async Task OnInitializedAsync() =>
        _loaded = await InOperationAsync(_ => Task.CompletedTask);
}
