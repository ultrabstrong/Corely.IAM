@using System.Security.Cryptography
@using Corely.IAM.Web.Extensions
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject TimeProvider TimeProvider

<div class="section-divider mb-4">
    <div class="section-divider-label">Encryption &amp; Signing</div>
    <p class="text-muted mb-3">
        @DescriptionText Keys are provisioned automatically and stored encrypted - use the tools
        below to encrypt, decrypt and sign messages with them.
    </p>
    <ul class="nav nav-tabs flex-nowrap">
        <li class="nav-item">
            <button class="nav-link @(_activeKeyTab == 0 ? "active" : "")" @onclick="() => ShowTab(0)">
                <i class="bi bi-key me-1"></i>Symmetric<span class="d-none d-md-inline"> Encryption</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeKeyTab == 1 ? "active" : "")" @onclick="() => ShowTab(1)">
                <i class="bi bi-shield-lock me-1"></i>Asymmetric<span class="d-none d-md-inline"> Encryption</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeKeyTab == 2 ? "active" : "")" @onclick="() => ShowTab(2)">
                <i class="bi bi-pen me-1"></i><span class="d-none d-md-inline">Digital </span>Signature
            </button>
        </li>
    </ul>
    <div class="tab-content pt-3">
        @if (_rotateResult != null)
        {
            <div class="alert @(_rotateFailed ? "alert-danger" : "alert-success") py-2">@_rotateResult</div>
        }
        @if (_revealError != null)
        {
            <div class="alert alert-danger py-2">@_revealError</div>
        }
        @if (_activeKeyTab == 0)
        {
            @if (SymProvider != null)
            {
                <div class="mb-3">
                    <span class="badge bg-secondary">@SymProvider.ProviderName</span>
                    <span class="badge text-bg-light border ms-1">Version @SymProvider.Version</span>
                    <small class="text-muted ms-2">@SymProvider.ProviderDescription</small>
                </div>
                @CompromisedVersions(KeyType.SymmetricEncryption, SymProvider.CompromisedVersions)
                @OlderVersions(KeyType.SymmetricEncryption, SymProvider.Version, SymProvider.CompromisedVersions)
            }
            <div class="mb-3">
                <label class="form-label fw-semibold">Input</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_symInput"
                          placeholder="Plaintext to encrypt, or ciphertext to decrypt"></textarea>
            </div>
            <div class="d-flex gap-2 mb-3 enc-actions">
                <button class="btn btn-primary btn-sm" @onclick="SymEncryptAsync" disabled="@_busy">Encrypt</button>
                <button class="btn btn-outline-primary btn-sm" @onclick="SymDecryptAsync" disabled="@_busy">Decrypt</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="SymReEncryptAsync" disabled="@_busy">Re-encrypt</button>
                @CopyKeyButton(KeyType.SymmetricEncryption)
                @if (RotateKeyAsync != null)
                {
                    <button class="btn btn-outline-warning btn-sm @RotateMargin enc-rotate" @onclick="() => ConfirmRotate(KeyType.SymmetricEncryption)" disabled="@_busy">Rotate key</button>
                }
            </div>
            @RevealedKey(KeyType.SymmetricEncryption)
            @if (_symOutput != null)
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Output</label>
                    <div class="d-flex align-items-start gap-1">
                        <textarea class="form-control form-control-sm font-monospace flex-grow-1" rows="1" style="field-sizing: content; resize: none;" onfocus="this.select()" readonly>@_symOutput</textarea>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CopySymOutputAsync" title="Copy">
                            <i class="bi @(_symOutputCopied ? "bi-check text-success" : "bi-copy")"></i>
                        </button>
                    </div>
                </div>
            }
            @if (_symError != null)
            {
                <div class="alert alert-danger py-2">@_symError</div>
            }
        }
        else if (_activeKeyTab == 1)
        {
            @if (AsymProvider != null)
            {
                <div class="mb-3">
                    <span class="badge bg-secondary">@AsymProvider.ProviderName</span>
                    <span class="badge text-bg-light border ms-1">Version @AsymProvider.Version</span>
                    <small class="text-muted ms-2">@AsymProvider.ProviderDescription</small>
                </div>
                @CompromisedVersions(KeyType.AsymmetricEncryption, AsymProvider.CompromisedVersions)
                @OlderVersions(KeyType.AsymmetricEncryption, AsymProvider.Version, AsymProvider.CompromisedVersions)
                <div class="mb-3">
                    <label class="form-label fw-semibold">Public Key</label>
                    <div class="d-flex align-items-start gap-1">
                        <textarea class="form-control form-control-sm font-monospace flex-grow-1" rows="1" style="field-sizing: content; resize: none;" onfocus="this.select()" readonly>@AsymProvider.PublicKey</textarea>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CopyAsymPublicKeyAsync" title="Copy">
                            <i class="bi @(_asymPublicKeyCopied ? "bi-check text-success" : "bi-copy")"></i>
                        </button>
                    </div>
                </div>
            }
            <div class="mb-3">
                <label class="form-label fw-semibold">Input</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_asymInput"
                          placeholder="Plaintext to encrypt, or ciphertext to decrypt"></textarea>
            </div>
            <div class="d-flex gap-2 mb-3 enc-actions">
                <button class="btn btn-primary btn-sm" @onclick="AsymEncryptAsync" disabled="@_busy">Encrypt</button>
                <button class="btn btn-outline-primary btn-sm" @onclick="AsymDecryptAsync" disabled="@_busy">Decrypt</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="AsymReEncryptAsync" disabled="@_busy">Re-encrypt</button>
                @CopyKeyButton(KeyType.AsymmetricEncryption)
                @if (RotateKeyAsync != null)
                {
                    <button class="btn btn-outline-warning btn-sm @RotateMargin enc-rotate" @onclick="() => ConfirmRotate(KeyType.AsymmetricEncryption)" disabled="@_busy">Rotate key</button>
                }
            </div>
            @RevealedKey(KeyType.AsymmetricEncryption)
            @if (_asymOutput != null)
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Output</label>
                    <div class="d-flex align-items-start gap-1">
                        <textarea class="form-control form-control-sm font-monospace flex-grow-1" rows="1" style="field-sizing: content; resize: none;" onfocus="this.select()" readonly>@_asymOutput</textarea>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CopyAsymOutputAsync" title="Copy">
                            <i class="bi @(_asymOutputCopied ? "bi-check text-success" : "bi-copy")"></i>
                        </button>
                    </div>
                </div>
            }
            @if (_asymError != null)
            {
                <div class="alert alert-danger py-2">@_asymError</div>
            }
        }
        else
        {
            @if (SigProvider != null)
            {
                <div class="mb-3">
                    <span class="badge bg-secondary">@SigProvider.ProviderName</span>
                    <span class="badge text-bg-light border ms-1">Version @SigProvider.Version</span>
                    <small class="text-muted ms-2">@SigProvider.ProviderDescription</small>
                </div>
                @CompromisedVersions(KeyType.AsymmetricSignature, SigProvider.CompromisedVersions)
                @OlderVersions(KeyType.AsymmetricSignature, SigProvider.Version, SigProvider.CompromisedVersions)
                <div class="mb-3">
                    <label class="form-label fw-semibold">Public Key</label>
                    <div class="d-flex align-items-start gap-1">
                        <textarea class="form-control form-control-sm font-monospace flex-grow-1" rows="1" style="field-sizing: content; resize: none;" onfocus="this.select()" readonly>@SigProvider.PublicKey</textarea>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CopySigPublicKeyAsync" title="Copy">
                            <i class="bi @(_sigPublicKeyCopied ? "bi-check text-success" : "bi-copy")"></i>
                        </button>
                    </div>
                </div>
            }
            <div class="mb-3">
                <label class="form-label fw-semibold">Payload</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_sigPayload"
                          placeholder="Text to sign or verify"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Signature</label>
                <textarea class="form-control form-control-sm font-monospace" rows="2" @bind="_sigSignature"
                          placeholder="Signature value (populated by Sign, required for Verify)"></textarea>
            </div>
            <div class="d-flex gap-2 mb-3 enc-actions">
                <button class="btn btn-primary btn-sm" @onclick="SignAsync" disabled="@_busy">Sign</button>
                <button class="btn btn-outline-primary btn-sm" @onclick="VerifyAsync" disabled="@_busy">Verify</button>
                @CopyKeyButton(KeyType.AsymmetricSignature)
                @if (RotateKeyAsync != null)
                {
                    <button class="btn btn-outline-warning btn-sm @RotateMargin enc-rotate" @onclick="() => ConfirmRotate(KeyType.AsymmetricSignature)" disabled="@_busy">Rotate key</button>
                }
            </div>
            @RevealedKey(KeyType.AsymmetricSignature)
            @if (_sigResult != null)
            {
                <div class="alert @(_sigResultIsValid == true ? "alert-success" : _sigResultIsValid == false ? "alert-danger" : "alert-info") py-2">@_sigResult</div>
            }
            @if (_sigError != null)
            {
                <div class="alert alert-danger py-2">@_sigError</div>
            }
        }
    </div>
</div>

<ConfirmModal @ref="_rotateModal" Title="Rotate Key" Message="@_rotateConfirmMessage" ConfirmText="Rotate" Type="ConfirmModalType.Warning" OnConfirm="RotateAsync" ChildContent="RotateModalContent" />

<FormModal @ref="_proofModal" Title="@_proofTitle" ConfirmText="@_proofConfirmText" OnConfirm="SubmitProofAsync">
    @_proofWarning
    @if (RevealGoogleClientId == null)
    {
        <div class="mb-3">
            <label class="form-label">Your password</label>
            <PasswordInput @bind-Value="_revealPassword" />
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Sign in with Google again to prove it is you</label>
            <div id="@GOOGLE_BUTTON_ID"></div>
            @if (_revealGoogleIdToken != null)
            {
                <small class="text-success">Google sign in received.</small>
            }
        </div>
    }
    <div class="mb-1">
        <label class="form-label">Authenticator or recovery code, if you use two factor</label>
        <input type="text" class="form-control form-control-sm" autocomplete="one-time-code" @bind="_revealTotpCode" />
    </div>
</FormModal>

@code {
    [Parameter]
    public string DescriptionText { get; set; } =
        "This user has its own symmetric and asymmetric encryption keys plus a signing key.";

    [Parameter]
    public IIamSymmetricEncryptionProvider? SymProvider { get; set; }

    [Parameter]
    public IIamAsymmetricEncryptionProvider? AsymProvider { get; set; }

    [Parameter]
    public IIamAsymmetricSignatureProvider? SigProvider { get; set; }

    [Parameter]
    public Func<KeyType, Task<ModifyResult>>? RotateKeyAsync { get; set; }

    [Parameter]
    public Func<KeyType, string?, string?, string?, string?, Task<CompromiseAccountKeyResult>>? RotateCompromisedKeyAsync { get; set; }

    [Parameter]
    public Func<KeyType, int, string?, string?, string?, string?, Task<CompromiseAccountKeyResult>>? MarkKeyCompromisedAsync { get; set; }

    [Parameter]
    public Func<KeyType, string?, string?, string?, string?, Task<RevealAccountKeyResult>>? RevealKeyAsync { get; set; }

    [Parameter]
    public string? RevealGoogleClientId { get; set; }

    [Parameter]
    public bool CanProveIdentity { get; set; } = true;

    private const int KEY_VISIBLE_SECONDS = 60;
    private const string GOOGLE_BUTTON_ID = "google-reauth-button";
    private const string NO_PROOF_MESSAGE =
        "This needs proof that it is you, and you have no way to give it yet. Set a password on your profile, then try again.";

    private FormModal _proofModal = null!;
    private string _proofTitle = string.Empty;
    private string _proofConfirmText = string.Empty;
    private RenderFragment? _proofWarning;
    private Func<string?, string?, string?, string?, Task>? _proofAction;
    private string _revealPassword = string.Empty;
    private string? _revealTotpCode;
    private string? _revealGoogleIdToken;
    private string? _revealGoogleNonce;
    private bool _renderGoogleButton;
    private IJSObjectReference? _googleModule;
    private DotNetObjectReference<EncryptionSigningPanel>? _selfRef;
    private string? _revealError;
    private KeyType _revealedKeyType;
    private string? _revealedKey;
    private string? _revealedProviderName;
    private int _revealedVersion;
    private bool _revealedKeyCopied;
    private CancellationTokenSource? _revealedKeyTimer;

    private string? RotateMargin => RevealKeyAsync == null ? "ms-auto" : null;

    private RenderFragment? RotateModalContent => RotateCompromisedKeyAsync == null ? null : RotateOptions;

    private RenderFragment RotateOptions =>
        @<text>
            <p>@_rotateConfirmMessage</p>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="mark-key-compromised" @bind="_markCompromised" />
                <label class="form-check-label" for="mark-key-compromised">Mark the old key compromised</label>
            </div>
            @if (_markCompromised)
            {
                <div class="alert alert-danger py-2 mt-2 mb-0">@_rotateKeyType.CompromiseWarning()</div>
            }
        </text>;

    private static RenderFragment CompromiseWarning(KeyType keyType) =>
        @<div class="alert alert-danger py-2">@keyType.CompromiseWarning()</div>;

    private RenderFragment OlderVersions(KeyType keyType, int currentVersion, IReadOnlyList<int>? compromised) =>
        @<text>
            @if (MarkKeyCompromisedAsync != null && Enumerable.Range(1, Math.Max(currentVersion - 1, 0)).Except(compromised ?? []).ToList() is { Count: > 0 } older)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <small class="text-muted">Older versions:</small>
                    @foreach (var version in older)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmMarkVersion(keyType, version)" disabled="@_busy">Mark version @version compromised</button>
                    }
                </div>
            }
        </text>;

    private static RenderFragment CompromisedVersions(KeyType keyType, IReadOnlyList<int>? versions) =>
        @<text>
            @if (versions is { Count: > 0 })
            {
                <div class="alert alert-warning py-2">Compromised: version @string.Join(", ", versions). @keyType.CompromisedNotice()</div>
            }
        </text>;

    private RenderFragment CopyKeyButton(KeyType keyType) =>
        @<text>
            @if (RevealKeyAsync != null)
            {
                <button class="btn btn-outline-secondary btn-sm ms-auto enc-rotate" @onclick="() => ConfirmReveal(keyType)" disabled="@_busy">@keyType.CopyKeyLabel()</button>
            }
        </text>;

    private RenderFragment KeyWarning(KeyType keyType) =>
        @<div class="alert alert-warning py-2">
            <ul class="mb-0 ps-3">
                @foreach (var warning in keyType.CopyKeyWarnings())
                {
                    <li>@warning</li>
                }
            </ul>
        </div>;

    private RenderFragment RevealedKey(KeyType keyType) =>
        @<text>
            @if (_revealedKey != null && _revealedKeyType == keyType)
            {
                <div class="mb-3">
                    @KeyWarning(keyType)
                    <label class="form-label fw-semibold">
                        @keyType.CopyKeyLabel(), version @_revealedVersion, @_revealedProviderName, @keyType.KeyFormat()
                    </label>
                    <div class="d-flex align-items-start gap-1">
                        <textarea class="form-control form-control-sm font-monospace flex-grow-1" rows="1" style="field-sizing: content; resize: none;" onfocus="this.select()" readonly>@_revealedKey</textarea>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CopyRevealedKeyAsync" title="Copy">
                            <i class="bi @(_revealedKeyCopied ? "bi-check text-success" : "bi-copy")"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ClearRevealedKey" title="Hide">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <small class="text-muted">Hidden after @KEY_VISIBLE_SECONDS seconds. The clipboard keeps what you copy, so clear it when you are done.</small>
                </div>
            }
        </text>;

    private void ShowTab(int tab)
    {
        _activeKeyTab = tab;
        _revealError = null;
        ClearRevealedKey();
    }

    private void ConfirmReveal(KeyType keyType) =>
        AskForProof(
            keyType.CopyKeyLabel(),
            "Show key",
            KeyWarning(keyType),
            (password, totpCode, googleIdToken, googleNonce) => RevealAsync(keyType, password, totpCode, googleIdToken, googleNonce)
        );

    private void ConfirmMarkVersion(KeyType keyType, int version) =>
        AskForProof(
            $"Mark version {version} compromised",
            "Mark compromised",
            CompromiseWarning(keyType),
            (password, totpCode, googleIdToken, googleNonce) => MarkVersionAsync(keyType, version, password, totpCode, googleIdToken, googleNonce)
        );

    private void AskForProof(string title, string confirmText, RenderFragment warning, Func<string?, string?, string?, string?, Task> action)
    {
        _proofTitle = title;
        _proofConfirmText = confirmText;
        _proofWarning = warning;
        _proofAction = action;
        _revealPassword = string.Empty;
        _revealTotpCode = null;
        _revealGoogleIdToken = null;
        _revealError = null;
        ClearRevealedKey();
        if (!CanProveIdentity)
        {
            _revealError = NO_PROOF_MESSAGE;
            return;
        }

        _revealGoogleNonce = RevealGoogleClientId == null ? null : Convert.ToHexString(RandomNumberGenerator.GetBytes(16));
        _renderGoogleButton = RevealGoogleClientId != null;
        _proofModal.Show();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_renderGoogleButton)
            return;

        _renderGoogleButton = false;
        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _googleModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Corely.IAM.Web/js/google-link.js"
            );
            await _googleModule.InvokeVoidAsync(
                "renderReauthButton",
                GOOGLE_BUTTON_ID,
                RevealGoogleClientId,
                _revealGoogleNonce,
                _selfRef
            );
        }
        catch (JSException)
        {
            _revealError = "Could not load Google sign-in. Check your connection and try again.";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnGoogleReauthCredential(string credential)
    {
        _revealGoogleIdToken = credential;
        StateHasChanged();
    }

    private async Task SubmitProofAsync()
    {
        if (_proofAction == null) return;
        var action = _proofAction;
        var password = _revealPassword;
        var totpCode = _revealTotpCode;
        var googleIdToken = _revealGoogleIdToken;
        var googleNonce = _revealGoogleNonce;
        _revealPassword = string.Empty;
        _revealTotpCode = null;
        _revealGoogleIdToken = null;
        _revealGoogleNonce = null;
        _proofAction = null;
        await action(password, totpCode, googleIdToken, googleNonce);
    }

    private async Task RevealAsync(KeyType keyType, string? password, string? totpCode, string? googleIdToken, string? googleNonce)
    {
        if (RevealKeyAsync == null) return;
        var result = await RevealKeyAsync(keyType, password, totpCode, googleIdToken, googleNonce);
        if (result.ResultCode != RevealAccountKeyResultCode.Success)
        {
            _revealError = result.Message;
            return;
        }

        _revealedKeyType = keyType;
        _revealedKey = result.ReadKey();
        _revealedProviderName = result.ProviderName;
        _revealedVersion = result.Version;
        _ = HideRevealedKeyLaterAsync();
    }

    private async Task HideRevealedKeyLaterAsync()
    {
        _revealedKeyTimer = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(KEY_VISIBLE_SECONDS), TimeProvider, _revealedKeyTimer.Token);
            await InvokeAsync(() =>
            {
                ClearRevealedKey();
                StateHasChanged();
            });
        }
        catch (TaskCanceledException) { }
    }

    private void ClearRevealedKey()
    {
        _revealedKeyTimer?.Cancel();
        _revealedKeyTimer?.Dispose();
        _revealedKeyTimer = null;
        _revealedKey = null;
        _revealedProviderName = null;
        _revealedKeyCopied = false;
    }

    private async Task CopyRevealedKeyAsync() => await CopyWithFeedbackAsync(_revealedKey, v => _revealedKeyCopied = v);

    public void Dispose()
    {
        ClearRevealedKey();
        _selfRef?.Dispose();
    }

    private ConfirmModal _rotateModal = null!;
    private KeyType _rotateKeyType;
    private string _rotateConfirmMessage = string.Empty;
    private string? _rotateResult;
    private bool _rotateFailed;
    private bool _markCompromised;

    private void ConfirmRotate(KeyType keyType)
    {
        _rotateKeyType = keyType;
        _rotateConfirmMessage = keyType.RotationWarning();
        _rotateResult = null;
        _markCompromised = false;
        ClearRevealedKey();
        _rotateModal.Show();
    }

    private async Task RotateAsync()
    {
        if (_markCompromised)
        {
            _markCompromised = false;
            var keyType = _rotateKeyType;
            AskForProof(
                "Rotate and mark compromised",
                "Rotate and mark compromised",
                CompromiseWarning(keyType),
                (password, totpCode, googleIdToken, googleNonce) => RotateCompromisedAsync(keyType, password, totpCode, googleIdToken, googleNonce)
            );
            return;
        }

        if (RotateKeyAsync == null) return;
        var result = await RotateKeyAsync(_rotateKeyType);
        _rotateFailed = result.ResultCode != ModifyResultCode.Success;
        _rotateResult = _rotateFailed
            ? $"Rotation failed: {result.Message}"
            : "Key rotated. Everything below now uses the new key.";
    }

    private async Task RotateCompromisedAsync(KeyType keyType, string? password, string? totpCode, string? googleIdToken, string? googleNonce)
    {
        if (RotateCompromisedKeyAsync == null) return;
        ReportCompromise(
            await RotateCompromisedKeyAsync(keyType, password, totpCode, googleIdToken, googleNonce),
            "Key rotated and the old key marked compromised. Everything below now uses the new key."
        );
    }

    private async Task MarkVersionAsync(KeyType keyType, int version, string? password, string? totpCode, string? googleIdToken, string? googleNonce)
    {
        if (MarkKeyCompromisedAsync == null) return;
        ReportCompromise(
            await MarkKeyCompromisedAsync(keyType, version, password, totpCode, googleIdToken, googleNonce),
            $"Version {version} marked compromised."
        );
    }

    private void ReportCompromise(CompromiseAccountKeyResult result, string success)
    {
        _rotateFailed = result.ResultCode != CompromiseAccountKeyResultCode.Success;
        _rotateResult = _rotateFailed ? result.Message : success;
    }

    private int _activeKeyTab;
    private bool _busy;

    private string _symInput = string.Empty;
    private string? _symOutput;
    private string? _symError;
    private bool _symOutputCopied;

    private string _asymInput = string.Empty;
    private string? _asymOutput;
    private string? _asymError;
    private bool _asymPublicKeyCopied;
    private bool _asymOutputCopied;

    private string _sigPayload = string.Empty;
    private string _sigSignature = string.Empty;
    private string? _sigResult;
    private bool? _sigResultIsValid;
    private string? _sigError;
    private bool _sigPublicKeyCopied;

    private async Task SymEncryptAsync()
    {
        if (string.IsNullOrWhiteSpace(_symInput)) return;
        _symOutput = null;
        _symError = null;
        await RunSafeAsync(() =>
        {
            if (SymProvider != null)
                _symOutput = SymProvider.Encrypt(_symInput);
        });
    }

    private async Task SymDecryptAsync()
    {
        if (string.IsNullOrWhiteSpace(_symInput)) return;
        _symOutput = null;
        _symError = null;
        await RunSafeAsync(() =>
        {
            if (SymProvider == null) return;
            try { _symOutput = SymProvider.Decrypt(_symInput); }
            catch (Exception ex) { _symError = $"Decryption failed: {ex.Message}"; }
        });
    }

    private async Task SymReEncryptAsync()
    {
        if (string.IsNullOrWhiteSpace(_symInput)) return;
        _symOutput = null;
        _symError = null;
        await RunSafeAsync(() =>
        {
            if (SymProvider == null) return;
            try { _symOutput = SymProvider.ReEncrypt(_symInput); }
            catch (Exception ex) { _symError = $"Re-encryption failed: {ex.Message}"; }
        });
    }

    private async Task AsymEncryptAsync()
    {
        if (string.IsNullOrWhiteSpace(_asymInput)) return;
        _asymOutput = null;
        _asymError = null;
        await RunSafeAsync(() =>
        {
            if (AsymProvider != null)
                _asymOutput = AsymProvider.Encrypt(_asymInput);
        });
    }

    private async Task AsymDecryptAsync()
    {
        if (string.IsNullOrWhiteSpace(_asymInput)) return;
        _asymOutput = null;
        _asymError = null;
        await RunSafeAsync(() =>
        {
            if (AsymProvider == null) return;
            try { _asymOutput = AsymProvider.Decrypt(_asymInput); }
            catch (Exception ex) { _asymError = $"Decryption failed: {ex.Message}"; }
        });
    }

    private async Task AsymReEncryptAsync()
    {
        if (string.IsNullOrWhiteSpace(_asymInput)) return;
        _asymOutput = null;
        _asymError = null;
        await RunSafeAsync(() =>
        {
            if (AsymProvider == null) return;
            try { _asymOutput = AsymProvider.ReEncrypt(_asymInput); }
            catch (Exception ex) { _asymError = $"Re-encryption failed: {ex.Message}"; }
        });
    }

    private async Task SignAsync()
    {
        if (string.IsNullOrWhiteSpace(_sigPayload)) return;
        _sigResult = null;
        _sigResultIsValid = null;
        _sigError = null;
        await RunSafeAsync(() =>
        {
            if (SigProvider != null)
            {
                _sigSignature = SigProvider.Sign(_sigPayload);
                _sigResult = "Payload signed. Signature populated below.";
            }
        });
    }

    private async Task VerifyAsync()
    {
        if (string.IsNullOrWhiteSpace(_sigPayload) || string.IsNullOrWhiteSpace(_sigSignature)) return;
        _sigResult = null;
        _sigResultIsValid = null;
        _sigError = null;
        await RunSafeAsync(() =>
        {
            if (SigProvider == null) return;
            try
            {
                var isValid = SigProvider.Verify(_sigPayload, _sigSignature);
                _sigResultIsValid = isValid;
                _sigResult = isValid ? "Signature is valid." : "Signature is invalid.";
            }
            catch (Exception ex) { _sigError = $"Verification failed: {ex.Message}"; }
        });
    }

    private async Task RunSafeAsync(Action action)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Task.Run(action);
        }
        catch (Exception ex)
        {
            _symError ??= _asymError ??= _sigError ??= $"Operation failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopySymOutputAsync() => await CopyWithFeedbackAsync(_symOutput, v => _symOutputCopied = v);
    private async Task CopyAsymPublicKeyAsync() => await CopyWithFeedbackAsync(AsymProvider?.PublicKey, v => _asymPublicKeyCopied = v);
    private async Task CopyAsymOutputAsync() => await CopyWithFeedbackAsync(_asymOutput, v => _asymOutputCopied = v);
    private async Task CopySigPublicKeyAsync() => await CopyWithFeedbackAsync(SigProvider?.PublicKey, v => _sigPublicKeyCopied = v);

    private async Task CopyWithFeedbackAsync(string? text, Action<bool> setFlag)
    {
        if (string.IsNullOrEmpty(text)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        setFlag(true);
        StateHasChanged();
        await Task.Delay(1500);
        setFlag(false);
        StateHasChanged();
    }
}
