<div class="input-group input-group-sm" style="max-width: 220px;">
    <input type="@(_shown ? "text" : "password")" class="form-control" placeholder="@Placeholder"
           value="@Value" @onchange="OnChangedAsync" />
    <button type="button" class="btn btn-outline-secondary" tabindex="-1"
            aria-label="@(_shown ? "Hide password" : "Show password")" @onclick="() => _shown = !_shown">
        <i class="bi @(_shown ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
    </button>
</div>

@code {
    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    private bool _shown;

    private Task OnChangedAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
