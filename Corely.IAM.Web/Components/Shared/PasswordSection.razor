@inherits OwningComponentBase

<div class="section-divider mb-4 mt-4">
    <div class="section-divider-label">Password</div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="mt-2">
            <Alert Message="@_message" Type="@_messageType" OnDismissed="() => _message = null" />
        </div>
    }
    @if (HasBasicAuth)
    {
        <p class="text-success mb-2"><i class="bi bi-check-circle me-1"></i>Password is set</p>
        @if (_showChangePassword)
        {
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <PasswordInput @bind-Value="_currentPassword" Placeholder="Current password" />
                <PasswordInput @bind-Value="_newPassword" Placeholder="New password" />
                <PasswordInput @bind-Value="_confirmPassword" Placeholder="Confirm password" />
                @if (_totpEnabled)
                {
                    <input class="form-control form-control-sm w-auto" @bind="_totpCode" placeholder="Authenticator code" autocomplete="one-time-code" />
                }
                <button class="btn btn-primary btn-sm" @onclick="ModifyAsync" disabled="@_busy">Save</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelChange">Cancel</button>
            </div>
        }
        else if (_showRemoveConfirm)
        {
            <p class="text-warning mb-2">Are you sure? You'll only be able to sign in with Google.</p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <PasswordInput @bind-Value="_currentPassword" Placeholder="Current password" />
                @if (_totpEnabled)
                {
                    <input class="form-control form-control-sm w-auto" @bind="_totpCode" placeholder="Authenticator code" autocomplete="one-time-code" />
                }
                <button class="btn btn-danger btn-sm" @onclick="RemoveAsync" disabled="@_busy">Confirm Remove</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelChange">Cancel</button>
            </div>
        }
        else
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm" @onclick="() => _showChangePassword = true" disabled="@_busy">
                    Change Password
                </button>
                @if (HasGoogleAuth)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _showRemoveConfirm = true" disabled="@_busy">
                        Remove Password
                    </button>
                }
            </div>
        }
    }
    else
    {
        <p class="text-muted mb-2">No password set. Add a password to enable username/password sign-in.</p>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <PasswordInput @bind-Value="_newPassword" Placeholder="New password" />
            <PasswordInput @bind-Value="_confirmPassword" Placeholder="Confirm password" />
            @if (_totpEnabled)
            {
                <input class="form-control form-control-sm w-auto" @bind="_totpCode" placeholder="Authenticator code" autocomplete="one-time-code" />
            }
            <button class="btn btn-primary btn-sm" @onclick="RegisterAsync" disabled="@_busy">Set Password</button>
        </div>
    }

</div>

@code {
    private IRegistrationService RegistrationService => ScopedServices.GetRequiredService<IRegistrationService>();
    private IModificationService ModificationService => ScopedServices.GetRequiredService<IModificationService>();
    private IDeregistrationService DeregistrationService => ScopedServices.GetRequiredService<IDeregistrationService>();
    private IMfaService MfaService => ScopedServices.GetRequiredService<IMfaService>();

    [Parameter]
    public bool HasBasicAuth { get; set; }

    [Parameter]
    public bool HasGoogleAuth { get; set; }

    [Parameter]
    public EventCallback OnStatusChanged { get; set; }

    private bool _showRemoveConfirm;
    private bool _showChangePassword;
    private bool _totpEnabled;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _totpCode = "";
    private bool _busy;
    private string? _message;
    private AlertType _messageType;

    protected override async Task OnInitializedAsync() =>
        await ScopedServices.GetRequiredService<IBlazorUserContextAccessor>().GetUserContextAsync();

    protected override async Task OnParametersSetAsync()
    {
        var status = await MfaService.GetTotpStatusAsync();
        _totpEnabled = status.ResultCode == TotpStatusResultCode.Success && status.IsEnabled;
    }

    private async Task RegisterAsync()
    {
        if (!NewPasswordIsValid())
            return;
        await RunSafeAsync(async () =>
        {
            var result = await RegistrationService.RegisterPasswordAsync(
                new RegisterPasswordRequest(_newPassword, TotpCodeOrNull()));
            await CompleteAsync(result.ResultCode == RegisterPasswordResultCode.Success, "Password set successfully.", result.Message);
        });
    }

    private async Task ModifyAsync()
    {
        if (!NewPasswordIsValid())
            return;
        await RunSafeAsync(async () =>
        {
            var result = await ModificationService.ModifyPasswordAsync(
                new ModifyPasswordRequest(_currentPassword, _newPassword, TotpCodeOrNull()));
            await CompleteAsync(result.ResultCode == ModifyPasswordResultCode.Success, "Password changed successfully.", result.Message);
        });
    }

    private async Task RemoveAsync()
    {
        await RunSafeAsync(async () =>
        {
            var result = await DeregistrationService.DeregisterBasicAuthAsync(
                new DeregisterBasicAuthRequest(_currentPassword, TotpCodeOrNull()));
            await CompleteAsync(result.ResultCode == DeregisterBasicAuthResultCode.Success, "Password removed.", result.Message);
        });
    }

    private bool NewPasswordIsValid()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            SetMessage(false, "Password is required.");
            return false;
        }
        if (_newPassword != _confirmPassword)
        {
            SetMessage(false, "Passwords do not match.");
            return false;
        }
        return true;
    }

    private string? TotpCodeOrNull() => string.IsNullOrWhiteSpace(_totpCode) ? null : _totpCode.Trim();

    private async Task CompleteAsync(bool succeeded, string successMessage, string failureMessage)
    {
        if (succeeded)
        {
            CancelChange();
            SetMessage(true, successMessage);
            await OnStatusChanged.InvokeAsync();
        }
        else
        {
            SetMessage(false, failureMessage);
        }
    }

    private void CancelChange()
    {
        _showChangePassword = false;
        _showRemoveConfirm = false;
        _currentPassword = "";
        _newPassword = "";
        _confirmPassword = "";
        _totpCode = "";
    }

    private async Task RunSafeAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await action(); }
        catch { SetMessage(false, "An unexpected error occurred."); }
        finally { _busy = false; }
    }

    private void SetMessage(bool success, string text)
    {
        _message = text;
        _messageType = success ? AlertType.Success : AlertType.Danger;
    }
}
