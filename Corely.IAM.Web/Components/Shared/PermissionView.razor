@using Corely.IAM.Web.Extensions
@inherits OperationComponentBase

@if (_checkComplete)
{
    if (_isAuthorized)
    {
        if (Authorized != null)
        {
            @Authorized
        }
        else
        {
            @ChildContent
        }
    }
    else if (NotAuthorized != null)
    {
        @NotAuthorized
    }
}
else if (Undetermined != null)
{
    @Undetermined
}

@code {

    [Parameter]
    public AuthAction Action { get; set; }

    [Parameter]
    public string Resource { get; set; } = string.Empty;

    [Parameter]
    public Guid[]? ResourceIds { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Authorized { get; set; }

    [Parameter]
    public RenderFragment? NotAuthorized { get; set; }

    [Parameter]
    public RenderFragment? Undetermined { get; set; }

    private bool _checkComplete;
    private bool _isAuthorized;
    private AuthAction _lastAction;
    private string _lastResource = string.Empty;
    private Guid[]? _lastResourceIds;

    // A parent re-renders often; only a change of what is asked opens an operation.
    protected override async Task OnParametersSetAsync()
    {
        if (
            _checkComplete
            && Action == _lastAction
            && Resource == _lastResource
            && ResourceIds.SameIdsAs(_lastResourceIds)
        )
        {
            return;
        }

        var (action, resource, resourceIds) = (Action, Resource, ResourceIds);
        var signedIn = await InOperationAsync(async services =>
        {
            _isAuthorized = await services.GetRequiredService<IAuthorizationProvider>().IsAuthorizedAsync(
                action,
                resource,
                resourceIds ?? []
            );
        });
        _checkComplete = signedIn;
        if (!signedIn)
            return;

        _lastAction = action;
        _lastResource = resource;
        _lastResourceIds = resourceIds;
    }
}
