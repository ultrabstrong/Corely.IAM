@page "/signin/start/{provider}"
@model Corely.IAM.Web.Pages.Authentication.FederatedSignInStartModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    <a href="@(Model.ReturnUrl ?? Corely.IAM.Web.AppRoutes.SignIn)" class="btn btn-outline-primary w-100">Back</a>
</div>
