@page "/signin"
@model Corely.IAM.Web.Pages.Authentication.SignInModel
@using Corely.IAM.Web.Extensions
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" type="button">Sign In</button>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" href="@Corely.IAM.Web.AppRoutes.Register.WithReturnUrl(Model.ReturnUrl)">Sign Up</a>
        </li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @await Html.PartialAsync("_SignInAssist")

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" name="Username"
                   value="@Model.Username" required autofocus />
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="Password" required />
        </div>
        <button type="submit" data-busy-spinner class="btn btn-primary w-100">Sign In</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ForgotPasswordPath))
    {
        <div class="mt-3 text-center">
            <a href="@Model.ForgotPasswordPath">Forgot password?</a>
        </div>
    }

    @await Html.PartialAsync("_IdentityProviderButtons", new Corely.IAM.Web.Pages.Authentication.IdentityProviderButtonsModel(false, Model.ReturnUrl))
</div>

@section Scripts {
    <script src="~/_content/Corely.IAM.Web/js/password-toggle.js"></script>
}
