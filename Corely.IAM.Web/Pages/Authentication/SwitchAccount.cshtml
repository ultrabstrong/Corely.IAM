@page "/switch-account"
@model Corely.IAM.Web.Pages.Authentication.SwitchAccountModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Switch Account";
}

<div class="auth-card text-center">
    <h4 class="mb-3">Switch account?</h4>
    <p class="text-muted">This link opens a different account from the one you are in.</p>
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="accountId" value="@Model.AccountId" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <button type="submit" data-busy-spinner class="btn btn-primary w-100">Continue</button>
    </form>
    <div class="mt-3">
        <a href="@Corely.IAM.Web.AppRoutes.SelectAccount">Back to accounts</a>
    </div>
</div>