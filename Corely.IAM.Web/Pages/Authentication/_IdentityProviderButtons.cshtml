@using Corely.IAM.IdentityProviders.Enums
@using Corely.IAM.Services
@using Corely.IAM.Web.Components.Shared
@using Corely.IAM.Web.Extensions
@model Corely.IAM.Web.Pages.Authentication.IdentityProviderButtonsModel
@inject IFederatedSignInService FederatedSignInService
@{
    var providers = (await FederatedSignInService.ListIdentityProvidersAsync())
        .Where(p => !Model.SignUp || p.AllowsSignUp)
        .ToList();
}

@if (providers.Count > 0)
{
    <div class="d-flex align-items-center my-3 text-muted small">
        <hr class="flex-grow-1" />
        <span class="px-2">or</span>
        <hr class="flex-grow-1" />
    </div>
    <div class="idp-buttons">
        @foreach (var provider in providers)
        {
            @(await Html.RenderComponentAsync<IdentityProviderButton>(
                RenderMode.Static,
                new { Type = provider.Type, Href = provider.Type.StartPath(FederatedSignInPurpose.SignIn, Model.ReturnUrl) }))
        }
    </div>
    @if (!Model.SignUp && providers.Any(p => p.AllowsSignUp))
    {
        @await Html.PartialAsync("_SignUpTerms", new Corely.IAM.Web.Pages.Authentication.SignUpTermsModel(true))
    }
}
