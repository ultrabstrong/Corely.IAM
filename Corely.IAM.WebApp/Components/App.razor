<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/Corely.IAM.Web/css/iam-web.css" />
    <script src="_content/Corely.IAM.Web/js/theme.js"></script>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <div id="blazor-error-ui" class="d-none">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">X</a>
    </div>

    <div id="components-reconnect-modal" class="components-reconnect-modal">
        <div class="components-reconnect-card">
            <div class="components-reconnect-show">
                <div class="spinner-border text-primary me-3" role="status"></div>
                <div>
                    <strong>Connection lost</strong>
                    <p class="mb-0 text-muted small">Attempting to reconnect...</p>
                </div>
            </div>
            <div class="components-reconnect-failed">
                <i class="bi bi-exclamation-triangle-fill text-danger me-3 fs-3"></i>
                <div>
                    <strong>Connection failed</strong>
                    <p class="mb-0 text-muted small">
                        Please <a href="" onclick="location.reload(); return false;">reload the page</a>.
                    </p>
                </div>
            </div>
            <div class="components-reconnect-rejected">
                <div class="spinner-border text-primary me-3" role="status"></div>
                <div>
                    <strong>A new version is up</strong>
                    <p class="mb-0 text-muted small">Reloading the page...</p>
                </div>
            </div>
        </div>
    </div>

    <script src="lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_content/Corely.IAM.Web/js/reconnect-reload.js"></script>
    <script src="_content/Corely.IAM.Web/lib/qrcodejs/qrcode.min.js"></script>
    <script src="_content/Corely.IAM.Web/js/qrcode-interop.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
