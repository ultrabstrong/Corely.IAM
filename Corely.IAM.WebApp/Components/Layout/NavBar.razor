@inherits OwningComponentBase
@inject NavigationManager NavigationManager
@inject IAccountDisplayState AccountDisplayState
@inject IOptions<IAMWebOptions> IamWebOptions

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="@WebAppRoutes.Home">Corely IAM</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#blazorNavbar" aria-controls="blazorNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"><i class="bi bi-list"></i></span>
        </button>
        <div class="collapse navbar-collapse" id="blazorNavbar">
            @if (_isAuthenticated && _hasAccount)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Identity &amp; Access</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@WebAppRoutes.Users(_accountId)"><i class="bi bi-people me-2"></i>Users</a></li>
                            <li><a class="dropdown-item" href="@WebAppRoutes.Groups(_accountId)"><i class="bi bi-diagram-3 me-2"></i>Groups</a></li>
                            <li><a class="dropdown-item" href="@WebAppRoutes.Roles(_accountId)"><i class="bi bi-shield-check me-2"></i>Roles</a></li>
                            <li><a class="dropdown-item" href="@WebAppRoutes.Permissions(_accountId)"><i class="bi bi-key me-2"></i>Permissions</a></li>
                        </ul>
                    </li>
                </ul>
            }
            @if (_isAuthenticated)
            {
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-building"></i> @(_hasAccount ? DisplayAccountName : "Accounts")
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (_hasAccount)
                            {
                                <li><a class="dropdown-item" href="@WebAppRoutes.Account(_accountId)"><i class="bi bi-gear me-2"></i>Manage account</a></li>
                                @if (_canOpenPlatformSettings)
                                {
                                    <li><a class="dropdown-item" href="@WebAppRoutes.PlatformSettings"><i class="bi bi-sliders me-2"></i>Platform settings</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><h6 class="dropdown-header">Other accounts</h6></li>
                            }
                            @if (_hasAccount ? _hasMultipleAccounts : _hasAnyAccounts)
                            {
                                <li><a class="dropdown-item" href="@AppRoutes.SelectAccount" data-enhance-nav="false"><i class="bi bi-arrow-left-right me-2"></i>@(_hasAccount ? "Switch account" : "Select account")</a></li>
                            }
                            <li><a class="dropdown-item" href="@AppRoutes.CreateAccount" data-enhance-nav="false"><i class="bi bi-plus-circle me-2"></i>Create account</a></li>
                            <li><a class="dropdown-item" href="@WebAppRoutes.AcceptInvitation"><i class="bi bi-envelope-open me-2"></i>Accept invitation</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person"></i> @_username
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="@WebAppRoutes.Profile"><i class="bi bi-person-gear me-2"></i>Profile</a></li>
                            @if (_hasAccount)
                            {
                                <li><a class="dropdown-item" href="@WebAppRoutes.Audit(_accountId)"><i class="bi bi-journal-text me-2"></i>Audit log</a></li>
                            }
                            <li><button type="button" class="dropdown-item theme-toggle-static" data-theme-toggle aria-label="Use dark theme"><i class="bi bi-moon-stars me-2" aria-hidden="true"></i><i class="bi bi-sun me-2" aria-hidden="true"></i>Switch theme</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="@AppRoutes.SignOut" data-enhance-nav="false"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                        </ul>
                    </li>
                </ul>
            }
            else
            {
                <div class="ms-auto">
                    <ThemeToggle />
                </div>
            }
        </div>
    </div>
</nav>

@code {
    private IBlazorUserContextAccessor BlazorUserContextAccessor => ScopedServices.GetRequiredService<IBlazorUserContextAccessor>();
    private IRetrievalService RetrievalService => ScopedServices.GetRequiredService<IRetrievalService>();
    private IAuthorizationProvider AuthorizationProvider => ScopedServices.GetRequiredService<IAuthorizationProvider>();

    private bool _isAuthenticated;
    private bool _hasAccount;
    private bool _canOpenPlatformSettings;
    private bool _hasAnyAccounts;
    private bool _hasMultipleAccounts;
    private Guid _accountId;
    private string? _username;
    private string? _accountName;

    private string? DisplayAccountName => AccountDisplayState.AccountName ?? _accountName;

    protected override async Task OnInitializedAsync()
    {
        var context = await BlazorUserContextAccessor.GetUserContextAsync();
        _isAuthenticated = context?.User != null;
        _hasAccount = context?.CurrentAccount != null;
        _canOpenPlatformSettings =
            context?.CurrentAccount?.IsPlatformAccount == true
            && (await IamWebOptions.Value.ReadablePlatformSettingsPagesAsync(AuthorizationProvider)).Count > 0;
        var enterableAccounts = _isAuthenticated ? await CountEnterableAccountsAsync() : 0;
        _hasAnyAccounts = enterableAccounts > 0;
        _hasMultipleAccounts = enterableAccounts > 1;
        _accountId = context?.CurrentAccount?.Id ?? Guid.Empty;
        _username = context?.User?.Username;
        _accountName = context?.CurrentAccount?.AccountName;
        AccountDisplayState.OnChanged += OnAccountNameChanged;
    }

    private async Task<int> CountEnterableAccountsAsync()
    {
        var result = await RetrievalService.ListAccountsAsync(new ListAccountsRequest(Take: 2));
        return result.Data?.TotalCount ?? 0;
    }

    private void OnAccountNameChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void Dispose(bool disposing)
    {
        AccountDisplayState.OnChanged -= OnAccountNameChanged;
        base.Dispose(disposing);
    }
}
