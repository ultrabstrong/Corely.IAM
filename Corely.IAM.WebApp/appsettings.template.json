{
  "ConnectionStrings": {
    "DefaultConnection": "<your-connection-string>"
  },
  "Database": {
    "Provider": "mssql"
  },
  "Security": {
    "SystemKey": "<your-system-symmetric-encryption-key>"
  },
  "SecurityOptions": {
    "GoogleClientId": ""
  },
  "DemoFeatures": {
    "EnablePasswordRecoveryPreview": true
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
